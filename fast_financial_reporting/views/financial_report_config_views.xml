<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fast_financial_report_config_list" model="ir.ui.view">
        <field name="name">fast.financial.report.config.list</field>
        <field name="model">fast.financial.report.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="posted_only"/>
                <field name="days_per_cron"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fast_financial_report_config_form" model="ir.ui.view">
        <field name="name">fast.financial.report.config.form</field>
        <field name="model">fast.financial.report.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                        <field name="posted_only"/>
                        <field name="daily_summary_enabled"/>
                        <field name="monthly_summary_enabled"/>
                        <field name="days_per_cron"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fast_financial_report_config" model="ir.actions.act_window">
        <field name="name">Fast Reporting Configuration</field>
        <field name="res_model">fast.financial.report.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
