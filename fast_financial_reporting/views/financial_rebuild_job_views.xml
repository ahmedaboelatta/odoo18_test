<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fast_financial_rebuild_job_list" model="ir.ui.view">
        <field name="name">fast.financial.rebuild.job.list</field>
        <field name="model">fast.financial.rebuild.job</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="state"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="current_date"/>
                <field name="processed_days"/>
                <field name="total_days"/>
                <field name="source_line_count"/>
                <field name="daily_rows"/>
                <field name="monthly_rows"/>
            </list>
        </field>
    </record>
    <record id="view_fast_financial_rebuild_job_form" model="ir.ui.view">
        <field name="name">fast.financial.rebuild.job.form</field>
        <field name="model">fast.financial.rebuild.job</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_process_next_batch"
                            string="Process Next Batch"
                            type="object"
                            class="btn-primary"
                            groups="fast_financial_reporting.group_fast_financial_reporting_admin"
                            invisible="state not in ['queued', 'running']"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            groups="fast_financial_reporting.group_fast_financial_reporting_admin"
                            invisible="state not in ['queued', 'running']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="next_date"/>
                            <field name="current_date"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="processed_days"/>
                            <field name="total_days"/>
                            <field name="source_line_count"/>
                            <field name="daily_rows"/>
                            <field name="monthly_rows"/>
                        </group>
                    </group>
                    <field name="last_error" invisible="not last_error"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fast_financial_rebuild_jobs" model="ir.actions.act_window">
        <field name="name">Rebuild Jobs</field>
        <field name="res_model">fast.financial.rebuild.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
