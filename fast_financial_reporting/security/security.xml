<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fast_financial_reporting" model="ir.module.category">
        <field name="name">Fast Financial Reporting</field>
        <field name="description">Access to fast summarized financial reports.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_fast_financial_reporting_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="fast_financial_reporting.module_category_fast_financial_reporting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_fast_financial_reporting_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="fast_financial_reporting.module_category_fast_financial_reporting"/>
        <field name="implied_ids" eval="[(4, ref('fast_financial_reporting.group_fast_financial_reporting_user'))]"/>
    </record>

    <record id="group_fast_financial_reporting_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="fast_financial_reporting.module_category_fast_financial_reporting"/>
        <field name="implied_ids" eval="[(4, ref('fast_financial_reporting.group_fast_financial_reporting_manager'))]"/>
    </record>
</odoo>
