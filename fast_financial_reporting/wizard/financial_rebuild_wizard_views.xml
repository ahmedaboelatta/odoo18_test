<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fast_financial_rebuild_wizard_form" model="ir.ui.view">
        <field name="name">fast.financial.rebuild.wizard.form</field>
        <field name="model">fast.financial.rebuild.wizard</field>
        <field name="arch" type="xml">
            <form string="Queue Reporting Rebuild">
                <group>
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="confirmation"/>
                </group>
                <footer>
                    <button name="action_queue_rebuild"
                            string="Queue Rebuild"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_fast_financial_rebuild_wizard" model="ir.actions.act_window">
        <field name="name">Rebuild Period</field>
        <field name="res_model">fast.financial.rebuild.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
