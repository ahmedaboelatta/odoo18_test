<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_identity_list" model="ir.ui.view">
        <field name="name">hader.mobile.identity.list</field>
        <field name="model">hader.mobile.identity</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="employee_id"/>
                <field name="login_identifier"/>
                <field name="verification_policy"/>
                <field name="bound_device_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="last_authenticated_at"/>
            </list>
        </field>
    </record>
    <record id="view_mobile_identity_form" model="ir.ui.view">
        <field name="name">hader.mobile.identity.form</field>
        <field name="model">hader.mobile.identity</field>
        <field name="arch" type="xml">
            <form string="Mobile Identity">
                <header>
                    <button name="action_reset_bound_devices" type="object" string="Reset Bound Device (فك ربط الجوال)" class="btn-secondary" groups="hader_mobile_core.group_mobile_admin"/>
                    <button name="action_clear_face_enrollment" type="object" string="Reset Reference Face (إعادة تعيين بصمة الوجه)" class="btn-secondary" invisible="not face_enrolled_at" groups="hader_mobile_core.group_mobile_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="invited,active,locked,revoked"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Employee &amp; Credentials">
                            <field name="employee_id" readonly="state != 'invited'"/>
                            <field name="login_identifier" readonly="state != 'invited'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="provisioning_password" password="True" placeholder="Minimum 6 characters"/>
                            <field name="bound_device_name"/>
                        </group>
                        <group string="Attendance Security &amp; Face Exemption">
                            <field name="verification_policy"/>
                            <field name="exemption_reason" invisible="verification_policy != 'alternative'" placeholder="مثال: موظفة منتقبة - إعفاء معتمد"/>
                            <field name="alternative_pin" password="True" invisible="verification_policy != 'alternative'" placeholder="Optional 4-6 digit PIN"/>
                            <field name="face_enrolled_at" invisible="verification_policy != 'face'"/>
                            <field name="reference_face_image" widget="image" class="oe_avatar" invisible="verification_policy != 'face'"/>
                        </group>
                    </group>
                    <group string="Authentication Status">
                        <field name="failed_attempts"/>
                        <field name="locked_until"/>
                        <field name="last_authenticated_at"/>
                    </group>
                    <notebook>
                        <page string="Devices">
                            <field name="device_ids" readonly="1"/>
                        </page>
                        <page string="Sessions">
                            <field name="session_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_mobile_identity_search" model="ir.ui.view">
        <field name="name">hader.mobile.identity.search</field><field name="model">hader.mobile.identity</field>
        <field name="arch" type="xml"><search><field name="employee_id"/><field name="login_identifier"/><field name="company_id"/><filter name="active_state" string="Active" domain="[('state','=','active')]"/><filter name="exempted" string="Exempted (Alternative Verification)" domain="[('verification_policy','=','alternative')]"/><filter name="invited" string="Invited" domain="[('state','=','invited')]"/><filter name="locked" string="Locked" domain="[('state','=','locked')]"/><filter name="revoked" string="Revoked" domain="[('state','=','revoked')]"/><separator/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><group><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_verification" string="Verification Policy" context="{'group_by':'verification_policy'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field>
    </record>
    <record id="action_mobile_identity" model="ir.actions.act_window">
        <field name="name">Mobile Identities</field>
        <field name="res_model">hader.mobile.identity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobile_identity_search"/>
    </record>
</odoo>
