<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_audit_list" model="ir.ui.view">
        <field name="name">hader.mobile.audit.list</field>
        <field name="model">hader.mobile.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="identity_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="outcome"/>
                <field name="request_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_audit_form" model="ir.ui.view">
        <field name="name">hader.mobile.audit.form</field>
        <field name="model">hader.mobile.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="event_type"/>
                        <field name="identity_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="outcome"/>
                        <field name="request_id"/>
                        <field name="metadata_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mobile_audit_search" model="ir.ui.view">
        <field name="name">hader.mobile.audit.search</field>
        <field name="model">hader.mobile.audit</field>
        <field name="arch" type="xml">
            <search string="Mobile Audit Log (سجل المراجعة الأمني)">
                <field name="event_type"/>
                <field name="identity_id"/>
                <field name="company_id"/>
                <field name="outcome"/>
                <field name="request_id"/>
                <filter name="filter_denied" string="محظور ومرفوض / Denied" domain="[('outcome', '=', 'denied')]"/>
                <filter name="filter_allowed" string="ناجح ومسموح / Allowed" domain="[('outcome', '=', 'allowed')]"/>
                <filter name="filter_error" string="أخطاء تقنية / Errors" domain="[('outcome', '=', 'error')]"/>
                <separator/>
                <filter name="group_outcome" string="النتيجة / Outcome" context="{'group_by': 'outcome'}"/>
                <filter name="group_event_type" string="نوع الحدث الأمني / Event Type" context="{'group_by': 'event_type'}"/>
                <filter name="group_identity" string="حساب الموظف / Identity" context="{'group_by': 'identity_id'}"/>
                <filter name="group_company" string="الشركة / Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_date" string="التاريخ / Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_mobile_audit" model="ir.actions.act_window">
        <field name="name">Mobile Audit Log (سجل المراجعة الأمني)</field>
        <field name="res_model">hader.mobile.audit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobile_audit_search"/>
    </record>
</odoo>
