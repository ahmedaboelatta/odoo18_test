<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hader_mobile" model="ir.module.category">
        <field name="name">Hader Mobile</field>
        <field name="sequence">80</field>
    </record>

    <record id="group_mobile_auditor" model="res.groups">
        <field name="name">Mobile Auditor</field>
        <field name="category_id" ref="module_category_hader_mobile"/>
    </record>

    <record id="group_mobile_admin" model="res.groups">
        <field name="name">Mobile Administrator</field>
        <field name="category_id" ref="module_category_hader_mobile"/>
        <field name="implied_ids" eval="[(4, ref('group_mobile_auditor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
