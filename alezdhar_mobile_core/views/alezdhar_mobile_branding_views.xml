<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_branding_list" model="ir.ui.view">
        <field name="name">alezdhar.mobile.branding.list</field>
        <field name="model">alezdhar.mobile.branding</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="app_name_en"/>
                <field name="app_name_ar"/>
                <field name="version"/>
                <field name="published_at"/>
            </list>
        </field>
    </record>
    <record id="view_mobile_branding_form" model="ir.ui.view">
        <field name="name">alezdhar.mobile.branding.form</field>
        <field name="model">alezdhar.mobile.branding</field>
        <field name="arch" type="xml">
            <form string="Mobile Branding">
                <header>
                    <button name="action_publish" type="object" string="Publish to App" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="app_name_en"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="app_name_ar"/>
                            <field name="app_name_en"/>
                            <field name="welcome_text_ar"/>
                            <field name="welcome_text_en"/>
                        </group>
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="primary_color" widget="color"/>
                            <field name="accent_color" widget="color"/>
                            <field name="version"/>
                            <field name="published_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_mobile_branding" model="ir.actions.act_window">
        <field name="name">App Branding</field>
        <field name="res_model">alezdhar.mobile.branding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
