<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_audit_list" model="ir.ui.view">
        <field name="name">alezdhar.mobile.audit.list</field>
        <field name="model">alezdhar.mobile.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="identity_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="outcome"/>
                <field name="request_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_audit_form" model="ir.ui.view">
        <field name="name">alezdhar.mobile.audit.form</field>
        <field name="model">alezdhar.mobile.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="event_type"/>
                        <field name="identity_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="outcome"/>
                        <field name="request_id"/>
                        <field name="metadata_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_audit" model="ir.actions.act_window">
        <field name="name">Mobile Audit Log</field>
        <field name="res_model">alezdhar.mobile.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
