<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_techrar_config_list" model="ir.ui.view">
        <field name="name">techrar.config.list</field>
        <field name="model">techrar.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="company_id"/><field name="techrar_app_id"/>
                <field name="connection_status" widget="badge"/><field name="auto_sync_enabled"/>
                <field name="last_successful_sync"/>
            </list>
        </field>
    </record>
    <record id="view_techrar_config_form" model="ir.ui.view">
        <field name="name">techrar.config.form</field>
        <field name="model">techrar.config</field>
        <field name="arch" type="xml">
            <form string="Techrar Configuration">
                <header>
                    <button name="action_check_connection" type="object" string="Check Connection &amp; Setup" class="btn-primary"/>
                    <field name="connection_status" widget="statusbar" statusbar_visible="unknown,connected,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="API Connection">
                            <field name="name"/><field name="company_id" groups="base.group_multi_company"/>
                            <field name="techrar_api_url"/><field name="techrar_api_token" password="True"/>
                            <field name="techrar_app_id"/>
                        </group>
                        <group string="Sales and Invoicing">
                            <field name="general_product_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="auto_confirm_orders"/>
                            <field name="auto_create_invoices" invisible="not auto_confirm_orders"/>
                            <field name="auto_register_payments" invisible="not auto_create_invoices"/>
                        </group>
                    </group>
                    <group string="Payment Journals" invisible="not auto_register_payments">
                        <group>
                            <field name="myfatoorah_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="tamara_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="default_payment_journal_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Scheduled Sync">
                            <field name="auto_sync_enabled"/>
                            <field name="sync_interval_minutes" invisible="not auto_sync_enabled"/>
                            <field name="sync_lookback_days" invisible="not auto_sync_enabled"/>
                        </group>
                        <group string="Status">
                            <field name="last_connection_at"/><field name="last_successful_sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_techrar_config" model="ir.actions.act_window">
        <field name="name">Settings</field><field name="res_model">techrar.config</field><field name="view_mode">list,form</field>
    </record>
</odoo>
