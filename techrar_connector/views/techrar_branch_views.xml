<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_techrar_branch_list" model="ir.ui.view">
        <field name="name">techrar.branch.list</field>
        <field name="model">techrar.branch</field>
        <field name="arch" type="xml">
            <list string="Techrar Branches">
                <header>
                    <button name="action_sync_from_techrar" type="object"
                            string="Sync Pickup Locations" class="btn-primary"
                            groups="techrar_connector.module_techrar_connector_manager"/>
                </header>
                <field name="name"/>
                <field name="branch_name_en"/>
                <field name="techrar_branch_id"/>
                <field name="city_name_en"/>
                <field name="district" optional="show"/>
                <field name="employees_only_pickup" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="techrar_is_deleted" optional="hide"/>
                <field name="warehouse_id"/>
                <field name="analytic_account_id"/>
            </list>
        </field>
    </record>

    <record id="view_techrar_branch_form" model="ir.ui.view">
        <field name="name">techrar.branch.form</field>
        <field name="model">techrar.branch</field>
        <field name="arch" type="xml">
            <form string="Techrar Branch">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_sync_from_techrar" type="object"
                                class="oe_stat_button" icon="fa-refresh"
                                groups="techrar_connector.module_techrar_connector_manager">
                            <div class="o_stat_info"><span class="o_stat_text">Sync Locations</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Deleted in Techrar" bg_color="text-bg-danger"
                            invisible="not techrar_is_deleted"/>
                    <group>
                        <group string="Location">
                            <field name="name"/>
                            <field name="branch_name_en"/>
                            <field name="techrar_branch_id" readonly="1"/>
                            <field name="techrar_location_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Pickup Rules">
                            <field name="employees_only_pickup"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="warehouse_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <group>
                                    <field name="city_name_ar"/>
                                    <field name="city_name_en"/>
                                    <field name="district_ar"/>
                                    <field name="district"/>
                                    <field name="route"/>
                                    <field name="street_number"/>
                                    <field name="postal_code"/>
                                </group>
                                <group>
                                    <field name="address1"/>
                                    <field name="address2"/>
                                    <field name="formatted_address"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="location_url" widget="url"/>
                                    <field name="place_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Techrar Data">
                            <group>
                                <group>
                                    <field name="city_id"/>
                                    <field name="country_id_techrar"/>
                                    <field name="country_code"/>
                                    <field name="city_keywords"/>
                                    <field name="city_is_supported"/>
                                    <field name="zone_id"/>
                                    <field name="app_id"/>
                                </group>
                                <group>
                                    <field name="ordering"/>
                                    <field name="is_synced"/>
                                    <field name="techrar_is_deleted"/>
                                    <field name="techrar_created_at"/>
                                    <field name="techrar_modified_at"/>
                                </group>
                            </group>
                        </page>
                        <page string="Raw API Data" groups="techrar_connector.module_techrar_connector_manager">
                            <field name="raw_payload" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_techrar_branch_search" model="ir.ui.view">
        <field name="name">techrar.branch.search</field>
        <field name="model">techrar.branch</field>
        <field name="arch" type="xml">
            <search string="Techrar Branches">
                <field name="name"/>
                <field name="branch_name_en"/>
                <field name="techrar_branch_id"/>
                <field name="city_name_en"/>
                <field name="district"/>
                <field name="tag_ids"/>
                <filter name="employees_only" string="Site Employees Only"
                        domain="[('employees_only_pickup', '=', True)]"/>
                <filter name="public_pickup" string="Open to All Customers"
                        domain="[('employees_only_pickup', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_city" string="City" context="{'group_by': 'city_name_en'}"/>
                    <filter name="group_restriction" string="Pickup Restriction"
                            context="{'group_by': 'employees_only_pickup'}"/>
                    <filter name="group_tags" string="Tags" context="{'group_by': 'tag_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_techrar_branch" model="ir.actions.act_window">
        <field name="name">Techrar Branches</field>
        <field name="res_model">techrar.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_techrar_branch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Techrar Branch!
            </p>
        </field>
    </record>
</odoo>
