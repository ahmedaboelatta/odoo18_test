<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_techrar_product_mapping_list" model="ir.ui.view">
        <field name="name">techrar.product.mapping.list</field><field name="model">techrar.product.mapping</field>
        <field name="arch" type="xml"><list decoration-warning="mapping_state == 'unmapped'">
            <field name="techrar_external_id"/><field name="techrar_name"/><field name="product_id"/>
            <field name="mapping_state" widget="badge"/><field name="last_seen_at"/><field name="active"/>
        </list></field>
    </record>
    <record id="view_techrar_product_mapping_form" model="ir.ui.view">
        <field name="name">techrar.product.mapping.form</field><field name="model">techrar.product.mapping</field>
        <field name="arch" type="xml"><form><sheet><group>
            <field name="techrar_external_id" readonly="1"/><field name="techrar_name"/><field name="product_id"/>
            <field name="mapping_state" readonly="1"/><field name="last_seen_at" readonly="1"/><field name="active"/>
        </group></sheet></form></field>
    </record>
    <record id="action_techrar_product_mapping" model="ir.actions.act_window">
        <field name="name">Product Mappings</field><field name="res_model">techrar.product.mapping</field><field name="view_mode">list,form</field>
    </record>
</odoo>
