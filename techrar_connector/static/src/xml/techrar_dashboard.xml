<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="techrar_connector.TechrarDashboard">
        <div class="o_techrar_dashboard">
            <div class="o_techrar_dashboard_header">
                <div>
                    <h1>Techrar Operations Dashboard</h1>
                    <span t-if="state.data">
                        Period: <t t-esc="state.data.from_date"/>
                        <t t-if="state.data.from_date != state.data.to_date">
                            — <t t-esc="state.data.to_date"/>
                        </t>
                    </span>
                </div>
                <div class="o_techrar_dashboard_filters">
                    <label>From
                        <input type="date" class="form-control" t-model="state.fromDate"/>
                    </label>
                    <label>To
                        <input type="date" class="form-control" t-model="state.toDate"/>
                    </label>
                    <button class="btn btn-secondary" t-on-click="showToday" t-att-disabled="state.loading">Today</button>
                    <button class="btn btn-primary" t-on-click="applyDateFilter" t-att-disabled="state.loading">Apply</button>
                    <button class="btn btn-outline-primary" t-on-click="loadData" t-att-disabled="state.loading">Refresh</button>
                </div>
            </div>

            <div t-if="state.loading" class="o_techrar_dashboard_loading">Loading dashboard…</div>
            <div t-elif="state.error" class="alert alert-danger" t-esc="state.error"/>
            <t t-elif="state.data">
                <div class="o_techrar_kpi_grid">
                    <button class="o_techrar_kpi" t-on-click="() => this.openOrders()">
                        <span>Orders</span><strong t-esc="state.data.orders.total"/>
                    </button>
                    <button class="o_techrar_kpi" t-on-click="() => this.openOrders('paid')">
                        <span>Paid</span><strong class="text-success" t-esc="state.data.payments.paid"/>
                    </button>
                    <button class="o_techrar_kpi" t-on-click="() => this.openOrders('not_paid')">
                        <span>Not Paid</span><strong class="text-danger" t-esc="state.data.payments.not_paid"/>
                    </button>
                    <button class="o_techrar_kpi" t-on-click="() => this.openOrders('partial')">
                        <span>Partially Paid</span><strong class="text-warning" t-esc="state.data.payments.partial"/>
                    </button>
                    <button class="o_techrar_kpi" t-on-click="() => this.openQueue('pending')">
                        <span>Pending Webhooks</span><strong class="text-warning" t-esc="state.data.queue.pending"/>
                    </button>
                    <button class="o_techrar_kpi" t-on-click="() => this.openQueue('failed')">
                        <span>Failed Webhooks</span><strong class="text-danger" t-esc="state.data.queue.failed"/>
                    </button>
                </div>

                <div class="o_techrar_panel_grid">
                    <section class="o_techrar_panel">
                        <h3>Financial Overview</h3>
                        <dl>
                            <dt>Sales Total</dt><dd t-esc="formatMoney(state.data.orders.sales_total)"/>
                            <dt>Invoice Total</dt><dd t-esc="formatMoney(state.data.orders.invoice_total)"/>
                            <dt>Paid Amount</dt><dd class="text-success" t-esc="formatMoney(state.data.orders.paid_amount)"/>
                            <dt>Outstanding</dt><dd class="text-danger" t-esc="formatMoney(state.data.orders.residual_amount)"/>
                        </dl>
                    </section>
                    <section class="o_techrar_panel">
                        <h3>Processing Sources</h3>
                        <dl>
                            <dt>Webhook logs</dt><dd t-esc="state.data.sources.webhook"/>
                            <dt>Scheduled logs</dt><dd t-esc="state.data.sources.cron"/>
                            <dt>Manual logs</dt><dd t-esc="state.data.sources.manual"/>
                            <dt>Oldest Pending</dt><dd t-esc="state.data.queue.oldest_pending || '—'"/>
                        </dl>
                    </section>
                    <section class="o_techrar_panel">
                        <h3>Payment Providers</h3>
                        <div t-if="!state.data.providers.length" class="text-muted">No orders today.</div>
                        <div t-foreach="state.data.providers" t-as="provider" t-key="provider.name" class="o_techrar_provider">
                            <span t-esc="provider.name"/><strong t-esc="provider.count"/>
                        </div>
                    </section>
                    <section class="o_techrar_panel">
                        <h3>Integration Health</h3>
                        <dl>
                            <dt>Last Webhook</dt><dd t-esc="state.data.last_webhook || '—'"/>
                            <dt>Last Successful Sync</dt><dd t-esc="state.data.last_sync || '—'"/>
                            <dt>Processing Now</dt><dd t-esc="state.data.queue.processing"/>
                            <dt>No Invoice</dt><dd t-esc="state.data.payments.no_invoice"/>
                        </dl>
                    </section>
                </div>

                <section class="o_techrar_panel o_techrar_chart_panel">
                    <h3>Daily Sales &amp; Orders</h3>
                    <div class="o_techrar_chart_legend">
                        <span><i class="o_techrar_legend_sales"/> Sales</span>
                        <span><i class="o_techrar_legend_orders"/> Orders</span>
                    </div>
                    <div class="o_techrar_chart" t-if="state.data.daily_series.length">
                        <div t-foreach="state.data.daily_series" t-as="day" t-key="day.date" class="o_techrar_chart_day">
                            <div class="o_techrar_bars" t-att-title="day.label + ': ' + formatMoney(day.sales) + ', ' + day.orders + ' orders'">
                                <span class="o_techrar_bar o_techrar_sales_bar" t-att-style="'height:' + chartHeight(day.sales, 'sales')"/>
                                <span class="o_techrar_bar o_techrar_orders_bar" t-att-style="'height:' + chartHeight(day.orders, 'orders')"/>
                            </div>
                            <small t-esc="day.label"/>
                        </div>
                    </div>
                </section>

                <div class="o_techrar_exceptions_grid">
                    <section class="o_techrar_panel">
                        <h3>Payment Exceptions</h3>
                        <div t-if="!state.data.exceptions.orders.length" class="o_techrar_empty">No payment exceptions in this period.</div>
                        <div t-foreach="state.data.exceptions.orders" t-as="order" t-key="order.id"
                             class="o_techrar_exception_row" t-on-click="() => this.openOrder(order.id)">
                            <div><strong t-esc="order.techrar_order_id || order.name"/><small t-esc="order.date"/></div>
                            <div class="text-end"><span class="badge text-bg-warning" t-esc="order.payment_label"/><small t-esc="formatMoney(order.amount)"/></div>
                        </div>
                    </section>
                    <section class="o_techrar_panel">
                        <h3>Failed Webhooks</h3>
                        <div t-if="!state.data.exceptions.failed_webhooks.length" class="o_techrar_empty">No failed webhooks in this period.</div>
                        <div t-foreach="state.data.exceptions.failed_webhooks" t-as="event" t-key="event.id"
                             class="o_techrar_exception_row" t-on-click="() => this.openWebhook(event.id)">
                            <div><strong t-esc="event.techrar_order_id || 'Unknown order'"/><small t-esc="event.date"/></div>
                            <div class="text-end"><span class="badge text-bg-danger">Failed</span><small><t t-esc="event.attempts"/> attempts</small></div>
                        </div>
                    </section>
                </div>
            </t>
        </div>
    </t>
</templates>
