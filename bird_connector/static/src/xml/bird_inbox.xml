<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="bird_connector.BirdInbox">
<div class="o_bird_inbox h-100 d-flex flex-column">
  <div class="o_bird_inbox_body d-flex flex-grow-1 overflow-hidden">
    <aside class="o_bird_inbox_list border-end d-flex flex-column">
      <div class="o_bird_inbox_sidebar_header border-bottom">
        <div class="o_bird_inbox_sidebar_titlebar d-flex align-items-center justify-content-between gap-2">
          <h3 class="o_bird_inbox_sidebar_title m-0">WhatsApp</h3>
          <select class="form-select form-select-sm o_bird_sidebar_channel" title="WhatsApp Channel" t-on-change="setChannelFilter" t-att-value="state.channelId">
            <option value="0">All Channels</option>
            <t t-foreach="state.channels" t-as="channel" t-key="channel.id">
              <option t-att-value="channel.id" t-att-selected="state.channelId === channel.id"><t t-esc="channel.name"/></option>
            </t>
          </select>
        </div>

        <div class="o_bird_sidebar_search position-relative">
          <span class="fa fa-search o_bird_sidebar_search_icon"/>
          <input class="form-control" type="search" placeholder="Search by name or phone number" aria-label="Search conversations by contact name or phone number" t-att-value="state.search" t-on-input="onSearchInput"/>
          <button t-if="state.search" class="o_bird_sidebar_search_clear" type="button" title="Clear search" t-on-click="clearSearch"><span class="fa fa-times"/></button>
        </div>

        <div class="o_bird_inbox_filter_pills">
          <button t-att-class="'o_bird_filter_pill ' + (state.filter === 'all' ? 'active' : '')" t-on-click="() => this.setFilter('all')">All</button>
          <button t-att-class="'o_bird_filter_pill ' + (state.filter === 'unread' ? 'active' : '')" t-on-click="() => this.setFilter('unread')">Unread</button>
          <button t-att-class="'o_bird_filter_pill ' + (state.filter === 'needs_reply' ? 'active' : '')" t-on-click="() => this.setFilter('needs_reply')">Needs Reply</button>
          <button t-att-class="'o_bird_filter_pill ' + (state.filter === 'my' ? 'active' : '')" t-on-click="() => this.setFilter('my')">Mine</button>
          <button t-att-class="'o_bird_filter_pill ' + (state.filter === 'unassigned' ? 'active' : '')" t-on-click="() => this.setFilter('unassigned')">Unassigned</button>
          <button t-att-class="'o_bird_filter_pill ' + (state.filter === 'closed' ? 'active' : '')" t-on-click="() => this.setFilter('closed')">Closed</button>
          <div class="o_bird_lists_wrap position-relative">
            <button t-att-class="'o_bird_filter_pill o_bird_lists_trigger ' + ((state.teamFilterId || state.tagFilterId) ? 'active' : '')" type="button" title="Lists" t-on-click="toggleListsMenu">
              <span t-if="state.teamFilterId || state.tagFilterId" class="o_bird_lists_label"><t t-esc="this.listFilterLabel()"/></span>
              <span class="fa fa-chevron-down"/>
            </button>
            <div t-if="state.listsMenu" class="o_bird_lists_menu shadow-lg">
              <div class="o_bird_lists_menu_head"><strong>Lists</strong><small>Filter conversations</small></div>
              <button t-att-class="'o_bird_lists_menu_item ' + ((!state.teamFilterId &amp;&amp; !state.tagFilterId) ? 'active' : '')" type="button" t-on-click="clearListFilter">
                <span class="o_bird_list_dot all"/><span class="text-truncate">All conversations</span><span t-if="!state.teamFilterId &amp;&amp; !state.tagFilterId" class="fa fa-check ms-auto"/>
              </button>
              <div t-if="state.teams.length" class="o_bird_lists_menu_title">Teams / Queues</div>
              <t t-foreach="state.teams" t-as="team" t-key="team.id">
                <button t-att-class="'o_bird_lists_menu_item ' + (state.teamFilterId === team.id ? 'active' : '')" type="button" t-on-click="() => this.setTeamListFilter(team.id)">
                  <span class="o_bird_list_dot team"/><span class="text-truncate"><t t-esc="team.name"/></span><span class="o_bird_list_count"><t t-esc="team.conversation_count || 0"/></span><span t-if="state.teamFilterId === team.id" class="fa fa-check"/>
                </button>
              </t>
              <div t-if="state.tags.length" class="o_bird_lists_menu_title">Contact Lists</div>
              <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                <button t-att-class="'o_bird_lists_menu_item ' + (state.tagFilterId === tag.id ? 'active' : '')" type="button" t-on-click="() => this.setTagListFilter(tag.id)">
                  <span class="o_bird_list_dot" t-att-style="this.tagStyle(tag)"/><span class="text-truncate"><t t-esc="tag.name"/></span><span class="o_bird_list_count"><t t-esc="tag.conversation_count || 0"/></span><span t-if="state.tagFilterId === tag.id" class="fa fa-check"/>
                </button>
              </t>
              <div class="o_bird_lists_menu_footer">
                <button type="button" class="o_bird_lists_new" t-on-click="openListManager"><span class="fa fa-plus"/><span>New / Manage list</span></button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="o_bird_inbox_list_scroll flex-grow-1 overflow-auto">
      <t t-foreach="state.conversations" t-as="conv" t-key="conv.id">
        <div t-att-class="'o_bird_inbox_item border-bottom ' + (state.selected &amp;&amp; state.selected.id === conv.id ? 'active' : '') + (conv.unread_count ? ' unread' : '') + (conv.state === 'closed' ? ' closed' : '')"
             t-on-click="() => this.selectConversation(conv.id)">
          <div class="o_bird_conv_avatar" aria-hidden="true"><t t-esc="this.contactInitials(conv.contact)"/></div>
          <div class="o_bird_conv_content">
            <div class="o_bird_conv_head">
              <strong class="o_bird_inbox_contact" t-att-title="conv.contact"><t t-esc="conv.contact"/></strong>
              <small t-att-class="'o_bird_conv_time ' + (conv.unread_count ? 'has-unread' : '')"><t t-esc="this.formatTime(conv.last_message_at)"/></small>
            </div>
            <div class="o_bird_conv_number"><t t-esc="conv.number"/></div>

            <div class="o_bird_conv_preview_row">
              <span class="o_bird_inbox_preview" t-att-title="conv.last_message"><t t-esc="conv.last_message"/></span>
              <span t-if="conv.unread_count" class="o_bird_unread_badge"><t t-esc="conv.unread_count"/></span>
            </div>

            <div class="o_bird_conv_footer">
              <div class="o_bird_conv_meta">
                <span class="o_bird_meta_chip channel" t-att-title="conv.channel"><span class="fa fa-whatsapp"/><span><t t-esc="conv.channel"/></span></span>
                <span t-if="conv.team" class="o_bird_meta_chip team" t-att-title="conv.team"><span class="fa fa-users"/><span><t t-esc="conv.team"/></span></span>
                <span t-if="conv.assigned_user" class="o_bird_meta_chip assignee" t-att-title="conv.assigned_user"><span class="fa fa-user"/><span><t t-esc="conv.assigned_user"/></span></span>
                <span t-if="!conv.assigned_user" class="o_bird_meta_chip unassigned"><span class="fa fa-user-o"/>Unassigned</span>
              </div>
              <div t-if="(conv.tags &amp;&amp; conv.tags.length) || conv.needs_reply || conv.state === 'closed'" class="o_bird_conv_flags">
                <t t-foreach="conv.tags || []" t-as="tag" t-key="tag.id"><span class="o_bird_tag_chip" t-att-style="this.tagStyle(tag)"><t t-esc="tag.name"/></span></t>
                <span t-if="conv.needs_reply" class="o_bird_state_chip needs-reply">Needs Reply</span>
                <span t-if="conv.state === 'closed'" class="o_bird_state_chip closed">Closed</span>
              </div>
            </div>
          </div>
        </div>
      </t>
      <div t-if="!state.loading &amp;&amp; !state.conversations.length" class="p-4 text-center text-muted">No conversations in this view.</div>
      </div>
    </aside>

    <main class="o_bird_inbox_chat d-flex flex-column flex-grow-1 position-relative" t-if="state.selected" t-on-dragover="onDragOver" t-on-dragleave="onDragLeave" t-on-drop="onDrop">
      <div t-if="state.dragging" class="o_bird_drop_overlay"><div><span class="fa fa-cloud-upload fa-2x mb-2"/><strong>Drop photo or document here</strong></div></div>
      <div class="o_bird_inbox_chat_header border-bottom">
        <div class="o_bird_chat_identity">
          <div class="o_bird_chat_avatar" aria-hidden="true"><t t-esc="this.contactInitials(state.selected.contact)"/></div>
          <div class="o_bird_chat_identity_text min-w-0">
            <strong class="o_bird_chat_name text-truncate"><t t-esc="state.selected.contact"/></strong>
            <div class="o_bird_chat_number text-truncate"><t t-esc="state.selected.number"/></div>
            <div class="o_bird_chat_context">
              <span class="o_bird_header_chip channel"><span class="fa fa-whatsapp"/><t t-esc="state.selected.channel"/></span>
              <span t-if="state.selected.team" class="o_bird_header_chip team"><span class="fa fa-users"/><t t-esc="state.selected.team"/></span>
              <span t-if="state.selected.assigned_user" class="o_bird_header_chip assignee"><span class="fa fa-user"/><t t-esc="state.selected.assigned_user"/></span>
              <t t-foreach="state.selected.tags || []" t-as="tag" t-key="tag.id"><span class="o_bird_header_tag" t-att-style="this.tagStyle(tag)"><t t-esc="tag.name"/></span></t>
            </div>
          </div>
        </div>
        <div class="o_bird_chat_actions">
          <span t-if="state.selected.needs_reply" class="o_bird_header_state needs-reply">Needs Reply</span>
          <button t-if="state.selected.assigned_user_id !== state.currentUserId" class="btn btn-sm btn-outline-primary o_bird_take_btn" t-on-click="takeConversation"><span class="fa fa-hand-paper-o me-1"/>Take</button>
          <select class="form-select form-select-sm o_bird_team_select" title="Team / Queue" t-on-change="setTeam" t-att-value="state.selected.team_id || 0">
            <option value="0">No Team / Queue</option>
            <t t-foreach="state.teams" t-as="team" t-key="team.id"><option t-att-value="team.id" t-att-selected="state.selected.team_id === team.id"><t t-esc="team.name"/></option></t>
          </select>
          <select class="form-select form-select-sm o_bird_assignee_select" title="Assigned To" t-on-change="assignConversation" t-att-value="state.selected.assigned_user_id || 0">
            <option value="0">Unassigned</option>
            <t t-foreach="this.eligibleUsers()" t-as="user" t-key="user.id"><option t-att-value="user.id" t-att-selected="state.selected.assigned_user_id === user.id"><t t-esc="user.name"/></option></t>
          </select>
          <button class="btn btn-sm btn-light border o_bird_close_btn" t-on-click="toggleState"><span t-att-class="'fa me-1 ' + (state.selected.state === 'closed' ? 'fa-undo' : 'fa-check-circle-o')"/><t t-esc="state.selected.state === 'closed' ? 'Reopen' : 'Close'"/></button>
        </div>
      </div>

      <div class="o_bird_inbox_messages flex-grow-1 overflow-auto p-3">
        <t t-foreach="state.selected.messages" t-as="msg" t-key="msg.id">
          <div t-att-class="'o_bird_inbox_msgrow ' + (msg.direction === 'outbound' ? 'outbound' : 'inbound')">
            <div t-att-class="'o_bird_inbox_bubble ' + (msg.pending ? 'pending' : '')">
              <div t-if="msg.sent_by" class="small fw-semibold opacity-75"><t t-esc="msg.sent_by"/></div>

              <img t-if="msg.type === 'image' &amp;&amp; msg.media_url" t-att-src="msg.media_url" class="o_bird_media_image o_bird_media_clickable" loading="lazy" t-on-error="onMediaError" t-on-click="() => this.openMedia(msg)"/>
              <video t-if="msg.type === 'video' &amp;&amp; msg.media_url" t-att-src="msg.media_url" class="o_bird_media_video" controls="controls" preload="metadata"/>
              <audio t-if="msg.type === 'audio' &amp;&amp; msg.media_url" t-att-src="msg.media_url" class="o_bird_media_audio" controls="controls" preload="metadata"/>
              <a t-if="msg.type === 'file' &amp;&amp; msg.media_url" t-att-href="msg.media_url" target="_blank" rel="noopener" class="o_bird_media_file">
                <span class="fa fa-file-text-o me-2"/><t t-esc="this.fileLabel(msg)"/>
              </a>

              <div t-if="msg.body &amp;&amp; !(msg.media_url &amp;&amp; ['image','video','audio','file'].includes(msg.type) &amp;&amp; msg.body.startsWith('['))" class="o_bird_inbox_text"><t t-esc="msg.body"/></div>
              <div t-if="msg.caption &amp;&amp; msg.caption !== msg.body" class="o_bird_media_caption"><t t-esc="msg.caption"/></div>

              <div class="o_bird_inbox_meta">
                <t t-esc="this.formatTime(msg.message_at)"/>
                <span t-if="msg.direction === 'outbound'" class="ms-2 o_bird_status"><t t-esc="this.statusLabel(msg.status)"/></span>
              </div>
            </div>
          </div>
        </t>
      </div>

      <div class="o_bird_inbox_composer_wrap border-top" t-if="state.selected.state !== 'closed'">
        <div t-if="state.attachment" class="o_bird_attachment_chip mx-2 mt-2 d-flex align-items-center gap-2">
          <img t-if="state.attachment.preview" t-att-src="state.attachment.preview" class="o_bird_attachment_thumb"/>
          <span t-else="" class="fa fa-file-o"/>
          <div class="flex-grow-1 text-truncate">
            <strong class="d-block text-truncate"><t t-esc="state.attachment.name"/></strong>
            <small class="text-muted"><t t-esc="Math.round(state.attachment.size / 1024)"/> KB</small>
          </div>
          <button class="btn btn-sm btn-link text-danger" title="Remove attachment" t-on-click="clearAttachment"><span class="fa fa-times"/></button>
        </div>
        <div class="o_bird_inbox_composer d-flex gap-2 align-items-end">
          <input class="o_bird_photo_input d-none" type="file" accept="image/*" t-on-change="onAttachmentChange"/>
          <input class="o_bird_document_input d-none" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.ppt,.pptx" t-on-change="onAttachmentChange"/>
          <div class="o_bird_attach_menu_wrap position-relative">
            <button class="btn o_bird_composer_icon_btn" title="Attach" t-att-disabled="state.sending" t-on-click="toggleAttachmentMenu"><span class="fa fa-paperclip"/></button>
            <div t-if="state.attachmentMenu" class="o_bird_attach_menu shadow border rounded bg-white">
              <button class="o_bird_attach_menu_item" t-on-click="triggerDocument">
                <span class="fa fa-file-text-o o_bird_attach_menu_icon"/>
                <span>Document</span>
              </button>
              <button class="o_bird_attach_menu_item" t-on-click="triggerPhoto">
                <span class="fa fa-picture-o o_bird_attach_menu_icon"/>
                <span>Photo</span>
              </button>
            </div>
          </div>
          <textarea class="form-control o_bird_composer_textarea" rows="1" placeholder="Type your WhatsApp message or caption..." t-model="state.draft" t-on-keydown="onKeydown"/>
          <button class="btn btn-primary o_bird_send_btn" t-att-disabled="state.sending || (!state.draft.trim() &amp;&amp; !state.attachment)" t-on-click="send"><span class="fa fa-paper-plane me-1"/>Send</button>
        </div>
      </div>
      <div class="alert alert-secondary m-3" t-else="">Conversation closed. Reopen it to reply.</div>
    </main>

    <div class="o_bird_inbox_empty flex-grow-1 d-flex flex-column align-items-center justify-content-center text-center" t-else="">
      <div class="o_bird_inbox_empty_icon mb-3"><span class="fa fa-comments-o"/></div>
      <h3 class="mb-2">Bird WhatsApp Inbox</h3>
      <div class="text-muted mb-1">Select a conversation from the list to view messages and reply.</div>
      <small class="text-muted">Nothing is opened automatically, so simply entering Conversations will not mark or force any chat for reply.</small>
    </div>
  </div>

  <div t-if="state.previewMedia" class="o_bird_media_lightbox" t-on-click="closeMedia">
    <button class="o_bird_media_lightbox_close btn btn-light" t-on-click.stop="closeMedia"><span class="fa fa-times"/></button>
    <div class="o_bird_media_lightbox_inner" t-on-click.stop="">
      <img t-att-src="state.previewMedia.media_url" t-att-alt="state.previewMedia.caption || state.previewMedia.media_name || 'WhatsApp image'"/>
      <div t-if="state.previewMedia.caption" class="o_bird_media_lightbox_caption"><t t-esc="state.previewMedia.caption"/></div>
    </div>
  </div>
</div>
</t>
</templates>
