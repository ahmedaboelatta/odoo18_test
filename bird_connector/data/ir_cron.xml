<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_bird_refresh_message_status" model="ir.cron">
        <field name="name">Bird: Refresh Message Status</field>
        <field name="model_id" ref="model_bird_message_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_pending_status()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_bird_sync_connector" model="ir.cron">
        <field name="name">Bird: Sync Connector Data</field>
        <field name="model_id" ref="model_bird_organization"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_connector_data()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_bird_refresh_balance" model="ir.cron">
        <field name="name">Bird: Refresh Wallet Balance</field>
        <field name="model_id" ref="model_bird_organization"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_wallet_balances()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="seq_bird_bulk_send" model="ir.sequence">
        <field name="name">Bird Bulk Send</field>
        <field name="code">bird.bulk.send</field>
        <field name="prefix">BULK/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="ir_cron_bird_process_bulk_sends" model="ir.cron">
        <field name="name">Bird: Process WhatsApp Bulk Sends</field>
        <field name="model_id" ref="model_bird_bulk_send"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_bulk_sends()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_bird_reprocess_webhook_events" model="ir.cron">
        <field name="name">Bird: Reprocess Pending Status Webhooks</field>
        <field name="model_id" ref="model_bird_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_reprocess_pending_status_events()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_bird_reconcile_recent_inbound" model="ir.cron">
        <field name="name">Bird: Reconcile Recent WhatsApp Inbound</field>
        <field name="model_id" ref="model_bird_conversation"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_recent_inbound_messages()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
