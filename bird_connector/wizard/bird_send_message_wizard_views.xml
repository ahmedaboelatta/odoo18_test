<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bird_send_message_wizard_form" model="ir.ui.view">
        <field name="name">bird.send.message.wizard.form</field>
        <field name="model">bird.send.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Bird Message">
                <sheet>
                    <div class="oe_title">
                        <h2>Send WhatsApp Message</h2>
                    </div>
                    <group>
                        <group>
                            <field name="message_type" widget="radio"/>
                            <field name="organization_id"/>
                            <field name="workspace_id"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="receiver_mobile" placeholder="+9665XXXXXXXX"/>
                            <field name="reference" placeholder="Optional internal reference"/>
                            <field name="template_id" invisible="message_type != 'template'" required="message_type == 'template'"/>
                            <field name="locale" invisible="message_type != 'template'" required="message_type == 'template'"/>
                        </group>
                    </group>

                    <group string="Message" invisible="message_type == 'template'">
                        <field name="message_text" invisible="message_type != 'text'" required="message_type == 'text'" placeholder="Type your WhatsApp message..."/>
                        <field name="media_url" invisible="message_type not in ('image', 'file')" required="message_type in ('image', 'file')" placeholder="https://example.com/media/file"/>
                        <field name="filename" invisible="message_type != 'file'" placeholder="document.pdf"/>
                        <field name="caption" invisible="message_type not in ('image', 'file')" placeholder="Optional caption"/>
                    </group>

                    <group string="Template Preview" invisible="message_type != 'template' or not template_id">
                        <div style="background:#efeae2; border-radius:16px; padding:10px; max-width:520px;">
                            <div style="background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 2px rgba(0,0,0,.15);">
                                <div invisible="not preview_header_image">
                                    <field name="preview_header_image" widget="image" nolabel="1" style="width:100%; max-height:260px; object-fit:cover;"/>
                                </div>
                                <div style="padding:12px;">
                                    <div invisible="not preview_header_text" style="font-weight:700; margin-bottom:6px;">
                                        <field name="preview_header_text" nolabel="1" readonly="1"/>
                                    </div>
                                    <div invisible="locale != 'ar'" style="white-space:pre-wrap; direction:rtl; text-align:right;">
                                        <field name="preview_text" nolabel="1" readonly="1"/>
                                    </div>
                                    <div invisible="locale == 'ar'" style="white-space:pre-wrap; direction:ltr; text-align:left;">
                                        <field name="preview_text" nolabel="1" readonly="1"/>
                                    </div>
                                    <div invisible="not preview_footer_text" style="font-size:11px; color:#667781; margin-top:8px;">
                                        <field name="preview_footer_text" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                                <div invisible="not preview_button_1 and not preview_button_2 and not preview_button_3" style="border-top:1px solid #e9edef;">
                                    <div invisible="not preview_button_1" style="padding:9px; text-align:center; color:#00a884; font-weight:600;"><field name="preview_button_1" nolabel="1" readonly="1"/></div>
                                    <div invisible="not preview_button_2" style="padding:9px; text-align:center; color:#00a884; font-weight:600; border-top:1px solid #e9edef;"><field name="preview_button_2" nolabel="1" readonly="1"/></div>
                                    <div invisible="not preview_button_3" style="padding:9px; text-align:center; color:#00a884; font-weight:600; border-top:1px solid #e9edef;"><field name="preview_button_3" nolabel="1" readonly="1"/></div>
                                </div>
                            </div>
                        </div>
                    </group>

                    <group string="Template Variables" invisible="message_type != 'template' or not template_id">
                        <field name="parameter_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="key" readonly="1"/>
                                <field name="parameter_type" optional="hide"/>
                                <field name="value"/>
                                <field name="required" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send" string="Send WhatsApp" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bird_send_message_wizard" model="ir.actions.act_window">
        <field name="name">Send Message</field>
        <field name="res_model">bird.send.message.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
