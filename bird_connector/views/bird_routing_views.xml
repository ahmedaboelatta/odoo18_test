<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_bird_routing_rule_list" model="ir.ui.view">
    <field name="name">bird.routing.rule.list</field><field name="model">bird.routing.rule</field>
    <field name="arch" type="xml"><list string="Auto-Routing Rules" editable="bottom" default_order="sequence,id">
      <field name="sequence" widget="handle"/><field name="name"/><field name="channel_id"/><field name="tag_id"/><field name="keyword"/>
      <field name="team_id"/><field name="assigned_user_id"/><field name="active" widget="boolean_toggle"/>
    </list></field>
  </record>
  <record id="view_bird_routing_rule_form" model="ir.ui.view">
    <field name="name">bird.routing.rule.form</field><field name="model">bird.routing.rule</field>
    <field name="arch" type="xml"><form string="Auto-Routing Rule"><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
      <group><group string="Match"><field name="sequence"/><field name="channel_id"/><field name="tag_id"/><field name="keyword"/></group>
      <group string="Route"><field name="team_id"/><field name="assigned_user_id" domain="[('share','=',False)]"/><field name="active"/></group></group>
      <div class="text-muted">The first active rule that matches is used. Manual Team / Queue assignment is never overwritten.</div>
    </sheet></form></field>
  </record>
  <record id="action_bird_routing_rule" model="ir.actions.act_window"><field name="name">Auto-Routing Rules</field><field name="res_model">bird.routing.rule</field><field name="view_mode">list,form</field></record>
</odoo>
