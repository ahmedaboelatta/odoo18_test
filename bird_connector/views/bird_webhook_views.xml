<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bird_webhook_subscription_list" model="ir.ui.view">
            <field name="name">bird.webhook.subscription.list</field>
            <field name="model">bird.webhook.subscription</field>
            <field name="arch" type="xml">
                <list create="false">
                    <field name="event"/>
                    <field name="channel_id"/>
                    <field name="ownership" widget="badge"
                           decoration-success="ownership == 'odoo'"
                           decoration-info="ownership == 'external'"/>
                    <field name="webhook_url" optional="show"/>
                    <field name="bird_subscription_id" optional="show"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'active'"
                           decoration-muted="status == 'inactive'"
                           decoration-danger="status == 'error'"/>
                    <field name="event_count"/>
                    <field name="last_event_at"/>
                    <field name="last_sync_at"/>
                </list>
            </field>
        </record>

        <record id="view_bird_webhook_subscription_form" model="ir.ui.view">
            <field name="name">bird.webhook.subscription.form</field>
            <field name="model">bird.webhook.subscription</field>
            <field name="arch" type="xml">
                <form string="Bird Webhook" create="false">
                    <header>
                        <button name="action_refresh_from_bird" type="object"
                                string="Sync from Bird" class="btn-primary" icon="fa-refresh"/>
                        <button name="action_deactivate_on_bird" type="object"
                                string="Deactivate" class="btn-secondary"
                                invisible="status != 'active' or not managed_by_connector"/>
                        <!-- Deliberately avoid statusbar here. The V1.9.0 form could
                             trigger an OWL statusbar rendering error in Odoo 18. -->
                        <field name="status" widget="badge"
                               decoration-success="status == 'active'"
                               decoration-muted="status == 'inactive'"
                               decoration-danger="status == 'error'"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="event"/>
                            <h1><field name="event" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Subscription">
                                <field name="organization_id" readonly="1"/>
                                <field name="workspace_id" readonly="1"/>
                                <field name="channel_id" readonly="1"/>
                                <field name="bird_subscription_id" readonly="1"/>
                                <field name="ownership" widget="badge" readonly="1"/>
                                <field name="managed_by_connector" invisible="1"/>
                            </group>
                            <group string="Endpoint">
                                <field name="webhook_url" readonly="1"/>
                                <field name="signing_key" password="True" readonly="1"
                                       invisible="not managed_by_connector"/>
                                <field name="event_count" readonly="1"/>
                                <field name="last_event_at" readonly="1"/>
                                <field name="last_sync_at" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Technical" groups="base.group_system">
                                <group>
                                    <field name="last_error" readonly="1"/>
                                </group>
                                <field name="raw_response" readonly="1" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_bird_webhook_event_list" model="ir.ui.view">
            <field name="name">bird.webhook.event.list</field>
            <field name="model">bird.webhook.event</field>
            <field name="arch" type="xml">
                <list create="false" delete="false">
                    <field name="received_at"/>
                    <field name="organization_id"/>
                    <field name="event"/>
                    <field name="channel_external_id" optional="show"/>
                    <field name="bird_message_id"/>
                    <field name="bird_status"/>
                    <field name="signature_valid"/>
                    <field name="processed"/>
                    <field name="processed_at" optional="hide"/>
                    <field name="processing_attempts" optional="hide"/>
                    <field name="matched_message_log_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_bird_webhook_event_form" model="ir.ui.view">
            <field name="name">bird.webhook.event.form</field>
            <field name="model">bird.webhook.event</field>
            <field name="arch" type="xml">
                <form string="Bird Webhook Event" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="received_at"/>
                                <field name="organization_id"/>
                                <field name="subscription_id"/>
                                <field name="event"/>
                            </group>
                            <group>
                                <field name="bird_message_id"/>
                                <field name="bird_status"/>
                                <field name="signature_valid"/>
                                <field name="processed"/>
                                <field name="processed_at"/>
                                <field name="processing_attempts"/>
                                <field name="matched_message_log_id"/>
                            </group>
                        </group>
                        <group string="Processing">
                            <field name="processing_error"/>
                        </group>
                        <group string="Raw Payload">
                            <field name="payload" nolabel="1" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bird_webhook_subscription" model="ir.actions.act_window">
            <field name="name">Webhooks</field>
            <field name="res_model">bird.webhook.subscription</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_bird_webhook_event" model="ir.actions.act_window">
            <field name="name">Webhook Events</field>
            <field name="res_model">bird.webhook.event</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
