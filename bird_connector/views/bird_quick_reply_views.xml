<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_bird_quick_reply_list" model="ir.ui.view">
    <field name="name">bird.quick.reply.list</field><field name="model">bird.quick.reply</field>
    <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="shortcut"/><field name="message"/><field name="team_id"/><field name="channel_id"/><field name="active"/></list></field>
  </record>
  <record id="view_bird_quick_reply_form" model="ir.ui.view">
    <field name="name">bird.quick.reply.form</field><field name="model">bird.quick.reply</field>
    <field name="arch" type="xml"><form string="Quick Reply"><sheet><group><field name="name"/><field name="shortcut" placeholder="welcome"/><field name="message"/><field name="team_id"/><field name="channel_id"/><field name="sequence"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="action_bird_quick_reply" model="ir.actions.act_window"><field name="name">Quick Replies</field><field name="res_model">bird.quick.reply</field><field name="view_mode">list,form</field></record>
</odoo>
