<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Kept inactive for upgrade compatibility with V1.8.0. The Bird UI now
             uses bird.configuration list/form views instead of General Settings. -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.bird.connector</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="active" eval="False"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <group string="Bird Connector" groups="base.group_system">
                        <field name="bird_auto_sync_templates"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
