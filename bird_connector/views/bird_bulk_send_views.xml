<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bird_bulk_send_list" model="ir.ui.view">
        <field name="name">bird.bulk.send.list</field>
        <field name="model">bird.bulk.send</field>
        <field name="arch" type="xml">
            <list string="Bulk Sends" create="0" default_order="create_date desc">
                <field name="name"/>
                <field name="template_id"/>
                <field name="channel_id"/>
                <field name="total_count"/>
                <field name="ready_count"/>
                <field name="invalid_count"/>
                <field name="sync_failed_count"/>
                <field name="submitted_count"/>
                <field name="delivered_count"/>
                <field name="failed_count"/>
                <field name="pending_count"/>
                <field name="progress" widget="progressbar"/>
                <field name="submission_rate" optional="hide"/>
                <field name="delivery_rate" optional="show"/>
                <field name="failure_rate" optional="show"/>
                <field name="scheduled_at" optional="show"/>
                <field name="next_run_at" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('queued','running')"
                       decoration-warning="state == 'paused' or state == 'partial'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_bird_bulk_send_form" model="ir.ui.view">
        <field name="name">bird.bulk.send.form</field>
        <field name="model">bird.bulk.send</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Bulk Send" create="0">
                <header>
                    <button name="action_process_now" string="Process Next Batch" type="object" class="btn-primary" invisible="state not in ('queued','running')"/>
                    <button name="action_pause" string="Pause" type="object" class="btn-secondary" invisible="state not in ('queued','running')"/>
                    <button name="action_resume" string="Resume" type="object" class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_retry_failed" string="Retry Failed" type="object" class="btn-secondary" invisible="failed_count == 0 or state == 'cancelled'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state not in ('queued','running','paused')"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,running,paused,done,partial,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_all_recipients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="total_count" widget="statinfo" string="Recipients"/>
                        </button>
                        <button name="action_open_delivered_recipients" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="delivered_count" widget="statinfo" string="Delivered"/>
                        </button>
                        <button name="action_open_failed_recipients" type="object" class="oe_stat_button" icon="fa-times-circle" invisible="failed_count == 0">
                            <field name="failed_count" widget="statinfo" string="Failed"/>
                        </button>
                        <button name="action_open_retryable_failed" type="object" class="oe_stat_button" icon="fa-repeat" invisible="retryable_failed_count == 0">
                            <field name="retryable_failed_count" widget="statinfo" string="Retryable"/>
                        </button>
                        <button name="action_open_failure_analysis" type="object" class="oe_stat_button" icon="fa-bar-chart" invisible="failed_count == 0">
                            <field name="failure_rate" widget="statinfo" string="Failure %"/>
                        </button>
                        <button name="action_open_messages" type="object" class="oe_stat_button" icon="fa-whatsapp">
                            <field name="submitted_count" widget="statinfo" string="Messages"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="template_id" readonly="1"/>
                            <field name="channel_id" readonly="1"/>
                            <field name="workspace_id" readonly="1"/>
                            <field name="organization_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_count" readonly="1"/>
                            <field name="ready_count" readonly="1"/>
                            <field name="invalid_count" readonly="1"/>
                            <field name="sync_failed_count" readonly="1"/>
                            <field name="submitted_count" readonly="1"/>
                            <field name="sent_count" readonly="1"/>
                            <field name="delivered_count" readonly="1"/>
                            <field name="failed_count" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="progress" widget="progressbar" readonly="1"/>
                            <field name="scheduled_at" readonly="state not in ('queued','paused')"/>
                            <field name="next_run_at" readonly="1"/>
                            <field name="batch_size" readonly="state not in ('queued','running','paused')"/>
                            <field name="batch_interval_minutes" readonly="state not in ('queued','running','paused')"/>
                            <field name="max_retries" readonly="state not in ('queued','running','paused')"/>
                        </group>
                    </group>
                    <group string="Campaign Performance">
                        <group>
                            <field name="submission_rate" readonly="1"/>
                            <field name="delivery_rate" readonly="1"/>
                            <field name="failure_rate" readonly="1"/>
                        </group>
                        <group>
                            <field name="retryable_failed_count" readonly="1"/>
                            <field name="non_retryable_failed_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="started_at" readonly="1"/>
                            <field name="last_run_at" readonly="1"/>
                            <field name="paused_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="locale" readonly="1"/>
                            <field name="reference" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recipients">
                            <field name="line_ids" readonly="1">
                                <list create="0" edit="0" delete="0" default_order="id asc">
                                    <field name="contact_id"/>
                                    <field name="phone_number"/>
                                    <field name="preflight_state" widget="badge" decoration-success="preflight_state == 'ready'" decoration-danger="preflight_state in ('invalid','sync_failed')" decoration-info="preflight_state == 'pending'"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'delivered'"
                                           decoration-danger="state == 'failed'"
                                           decoration-warning="state == 'retry'"
                                           decoration-info="state in ('pending','processing','submitted','sent')"
                                           decoration-muted="state == 'cancelled'"/>
                                    <field name="attempt_count"/>
                                    <field name="last_attempt_at"/>
                                    <field name="submitted_at" optional="hide"/>
                                    <field name="sent_at" optional="hide"/>
                                    <field name="delivered_at"/>
                                    <field name="message_log_id"/>
                                    <field name="failure_code" optional="show"/>
                                    <field name="failure_reason" optional="show"/>
                                    <field name="auto_retry_allowed" optional="hide"/>
                                    <field name="preflight_at" optional="hide"/>
                                    <field name="preflight_error" optional="show"/>
                                    <field name="error_message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" groups="base.group_system">
                            <field name="parameter_json" readonly="1" nolabel="1"/>
                            <field name="last_error" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bird_bulk_send_search" model="ir.ui.view">
        <field name="name">bird.bulk.send.search</field>
        <field name="model">bird.bulk.send</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <field name="channel_id"/>
                <filter name="queued" string="Active Campaigns" domain="[('state','in',('queued','running','paused'))]"/>
                <filter name="failed" string="With Errors" domain="[('failed_count','&gt;',0)]"/>
                <filter name="successful" string="100% Delivered" domain="[('total_count','&gt;',0),('delivery_rate','=',100)]"/>
                <filter name="created_today" string="Created Today" date="create_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_template" string="Template" context="{'group_by':'template_id'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by':'channel_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bird_bulk_send" model="ir.actions.act_window">
        <field name="name">Bulk Sends</field>
        <field name="res_model">bird.bulk.send</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bird_bulk_send_search"/>
    </record>
    <record id="view_bird_bulk_send_line_list" model="ir.ui.view">
        <field name="name">bird.bulk.send.line.analytics.list</field>
        <field name="model">bird.bulk.send.line</field>
        <field name="arch" type="xml">
            <list string="Campaign Recipients" create="0" edit="0" delete="0" default_order="id desc">
                <field name="batch_id"/>
                <field name="contact_id"/>
                <field name="phone_number"/>
                <field name="template_id" optional="show"/>
                <field name="channel_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'retry'"
                       decoration-info="state in ('pending','processing','submitted','sent')"
                       decoration-muted="state == 'cancelled'"/>
                <field name="preflight_state" widget="badge" optional="hide"/>
                <field name="attempt_count"/>
                <field name="delivered_at"/>
                <field name="failure_code" optional="show"/>
                <field name="failure_reason" optional="show"/>
                <field name="auto_retry_allowed" optional="show"/>
                <field name="message_log_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bird_bulk_send_line_pivot" model="ir.ui.view">
        <field name="name">bird.bulk.send.line.analytics.pivot</field>
        <field name="model">bird.bulk.send.line</field>
        <field name="arch" type="xml">
            <pivot string="Campaign Recipient Analytics">
                <field name="batch_id" type="row"/>
                <field name="state" type="col"/>
                <field name="recipient_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_bird_bulk_send_line_graph" model="ir.ui.view">
        <field name="name">bird.bulk.send.line.analytics.graph</field>
        <field name="model">bird.bulk.send.line</field>
        <field name="arch" type="xml">
            <graph string="Campaign Recipient Analytics" type="bar">
                <field name="state"/>
                <field name="recipient_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_bird_bulk_send_line_search" model="ir.ui.view">
        <field name="name">bird.bulk.send.line.analytics.search</field>
        <field name="model">bird.bulk.send.line</field>
        <field name="arch" type="xml">
            <search string="Campaign Recipient Analytics">
                <field name="batch_id"/>
                <field name="contact_id"/>
                <field name="phone_number"/>
                <field name="template_id"/>
                <field name="channel_id"/>
                <field name="failure_code"/>
                <filter name="delivered" string="Delivered" domain="[('state','=','delivered')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="retryable" string="Retryable Failed" domain="[('state','=','failed'),('auto_retry_allowed','=',True)]"/>
                <filter name="non_retryable" string="Non-Retryable Failed" domain="[('state','=','failed'),('auto_retry_allowed','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_campaign" string="Campaign" context="{'group_by':'batch_id'}"/>
                    <filter name="group_template" string="Template" context="{'group_by':'template_id'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by':'channel_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_failure_code" string="Failure Code" context="{'group_by':'failure_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bird_bulk_send_recipient_analytics" model="ir.actions.act_window">
        <field name="name">Campaign Analytics</field>
        <field name="res_model">bird.bulk.send.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_bird_bulk_send_line_search"/>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
