<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bird_contact_list" model="ir.ui.view">
            <field name="name">bird.contact.list</field>
            <field name="model">bird.contact</field>
            <field name="arch" type="xml">
                <list string="Bird Contacts" default_order="last_activity_at desc" decoration-muted="state == 'archived'">
                    <field name="name"/>
                    <field name="whatsapp_number"/>
                    <field name="email" optional="show"/>
                    <field name="country_id" optional="hide"/>
                    <field name="state_id" optional="hide"/>
                    <field name="gender" optional="hide"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="channel_id" optional="show"/>
                    <field name="workspace_id" optional="hide"/>
                    <field name="last_message" optional="show"/>
                    <field name="last_activity_at" optional="show"/>
                    <field name="unread_count" optional="show"/>
                    <field name="state" widget="badge" optional="show"
                           decoration-success="state == 'active'"
                           decoration-muted="state == 'archived'"/>
                </list>
            </field>
        </record>

        <record id="view_bird_contact_search" model="ir.ui.view">
            <field name="name">bird.contact.search</field>
            <field name="model">bird.contact</field>
            <field name="arch" type="xml">
                <search string="Search Bird Contacts">
                    <field name="name"/>
                    <field name="whatsapp_number"/>
                    <field name="email"/>
                    <field name="country_id"/>
                    <field name="state_id"/>
                    <field name="gender"/>
                    <field name="tag_ids"/>
                    <field name="workspace_id"/>
                    <field name="channel_id"/>
                    <filter name="unread" string="Unread" domain="[('unread_count', '&gt;', 0)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                    <separator/>
                    <filter name="group_tag" string="Tag" context="{'group_by': 'tag_ids'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_workspace" string="Workspace" context="{'group_by': 'workspace_id'}"/>
                </search>
            </field>
        </record>

        <record id="view_bird_contact_form" model="ir.ui.view">
            <field name="name">bird.contact.form</field>
            <field name="model">bird.contact</field>
            <field name="arch" type="xml">
                <form string="Bird Contact">
                    <header>
                        <button name="action_mark_read" type="object" string="Mark Read" class="btn-primary" invisible="unread_count == 0"/>
                        <button name="action_archive_contact" type="object" string="Archive" invisible="state == 'archived'"/>
                        <button name="action_restore_contact" type="object" string="Restore" invisible="state != 'archived'"/>
                        <button name="action_sync_bird_contact" type="object" string="Sync Bird Contact" class="btn-secondary" icon="fa-refresh"/>
                        <field name="state" widget="statusbar" statusbar_visible="active,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box"><button name="action_open_conversations" type="object" class="oe_stat_button" icon="fa-comments"><field name="conversation_count" widget="statinfo" string="Conversations"/></button></div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Contact name"/></h1>
                        </div>
                        <group>
                            <group string="Contact">
                                <field name="whatsapp_number" placeholder="+966..."/>
                                <field name="email" widget="email"/>
                                <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="state_id"
                                       domain="[('country_id', '=', country_id)]"
                                       invisible="not country_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="gender"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="linked_partner_id" options="{'no_create': True}"/>
                                <field name="bird_contact_id" readonly="1"/>
                                <field name="bird_sync_status" widget="badge" readonly="1"
                                       decoration-success="bird_sync_status == 'synced'"
                                       decoration-danger="bird_sync_status == 'error'"
                                       decoration-muted="bird_sync_status == 'not_synced'"/>
                                <field name="bird_synced_at" readonly="1" invisible="not bird_synced_at"/>
                                <field name="bird_sync_error" readonly="1" invisible="not bird_sync_error"/>
                            </group>
                            <group string="Bird">
                                <field name="organization_id" readonly="1"/>
                                <field name="workspace_id" readonly="1"/>
                                <field name="channel_id" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Activity">
                                <field name="last_activity_at" readonly="1"/>
                                <field name="last_message_at" readonly="1"/>
                                <field name="unread_count" readonly="1"/>
                            </group>
                            <group string="Last Message">
                                <field name="last_message" readonly="1" nolabel="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_bird_contact_tag_list" model="ir.ui.view">
            <field name="name">bird.contact.tag.list</field>
            <field name="model">bird.contact.tag</field>
            <field name="arch" type="xml">
                <list string="Bird Contact Tags" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_bird_contact_tag_form" model="ir.ui.view">
            <field name="name">bird.contact.tag.form</field>
            <field name="model">bird.contact.tag</field>
            <field name="arch" type="xml">
                <form string="Bird Contact Tag">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bird_contact" model="ir.actions.act_window">
            <field name="name">Contacts</field>
            <field name="res_model">bird.contact</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_bird_contact_search"/>
            <field name="context">{'active_test': True}</field>
        </record>

        <record id="action_bird_contact_tag" model="ir.actions.act_window">
            <field name="name">Contact Tags</field>
            <field name="res_model">bird.contact.tag</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_bird_contact_send_whatsapp" model="ir.actions.server">
            <field name="name">Send WhatsApp Message</field>
            <field name="model_id" ref="model_bird_contact"/>
            <field name="binding_model_id" ref="model_bird_contact"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_open_bulk_send_message()</field>
        </record>
    </data>
</odoo>
