<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bird_template_tree" model="ir.ui.view">
        <field name="name">bird.template.tree</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates" default_order="id desc">
                <field name="name"/>
                <field name="api_name"/>
                <field name="workspace_id"/>
                <field name="category"/>
                <field name="locale"/>
                <field name="source" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status=='active'" decoration-warning="status=='pending'" decoration-danger="status=='rejected'" decoration-muted="status=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_bird_template_search" model="ir.ui.view">
        <field name="name">bird.template.search</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <search string="Templates Search">
                <field name="name"/><field name="api_name"/><field name="workspace_id"/><field name="bird_template_id"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="Pending" name="pending" domain="[('status','=','pending')]"/>
                <filter string="Approved" name="approved" domain="[('status','=','active')]"/>
                <filter string="Rejected" name="rejected" domain="[('status','=','rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'category'}"/>
                    <filter string="Workspace" name="group_workspace" context="{'group_by':'workspace_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bird_template_form" model="ir.ui.view">
        <field name="name">bird.template.form</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="oe_highlight" invisible="status != 'draft' or source != 'odoo'"/>
                    <button name="action_refresh_approval_status" string="Refresh Status" type="object" class="btn-secondary" invisible="not bird_template_id"/>
                    <button name="action_sync_template" string="Sync Template" type="object" class="btn-secondary" invisible="not bird_template_id"/>
                    <button name="action_open_send_message" string="Send Message" type="object" class="oe_highlight" invisible="status != 'active'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="status not in ('active','rejected') or source != 'odoo'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,active,rejected"/>
                </header>
                <sheet>
                    <field name="source" invisible="1"/>
                    <field name="preview_button_1_type" invisible="1"/>
                    <field name="preview_button_2_type" invisible="1"/>
                    <field name="preview_button_3_type" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_versions" type="object" class="oe_stat_button" icon="fa-code-fork" invisible="not project_id">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Example: Order Ready"/></h1></div>
                    <group>
                        <group>
                            <field name="workspace_id" readonly="status != 'draft'"/>
                            <field name="channel_id" readonly="status != 'draft'"/>
                            <field name="api_name" readonly="status != 'draft'" placeholder="order_ready"/>
                            <field name="category" readonly="status != 'draft'"/>
                            <field name="locale" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="header_type" readonly="status != 'draft'"/>
                            <field name="header_text" invisible="header_type != 'text'" readonly="status != 'draft'"/>
                            <field name="header_image" filename="header_image_filename" widget="image" invisible="header_type != 'image'" readonly="status != 'draft'" class="oe_avatar" options="{'size': [320, 220]}" style="width:320px;max-width:320px;max-height:220px;object-fit:contain;"/>
                            <field name="header_image_filename" invisible="1"/>
                            <field name="header_video" filename="header_video_filename" invisible="header_type != 'video'" readonly="status != 'draft'"/>
                            <field name="header_video_filename" invisible="1"/>
                            <field name="header_document" filename="header_document_filename" invisible="header_type != 'document'" readonly="status != 'draft'"/>
                            <field name="header_document_filename" invisible="1"/>
                            <field name="header_location_name" invisible="header_type != 'location'" readonly="status != 'draft'"/>
                            <field name="header_location_address" invisible="header_type != 'location'" readonly="status != 'draft'"/>
                            <field name="header_location_latitude" invisible="header_type != 'location'" readonly="status != 'draft'"/>
                            <field name="header_location_longitude" invisible="header_type != 'location'" readonly="status != 'draft'"/>
                            <field name="header_media_url" invisible="1" readonly="1"/>
                            <field name="header_media_kind" invisible="1" readonly="1"/>
                            <field name="header_media_token" invisible="1" readonly="1"/>
                            <field name="footer_text" readonly="status != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Body">
                            <div class="d-flex justify-content-end mb-2" invisible="status != 'draft'">
                                <button name="action_add_body_variable" type="object" string="+ Variable" class="btn btn-link"/>
                            </div>
                            <field name="body" nolabel="1" readonly="status != 'draft'" placeholder="Write the WhatsApp template body here. You can type {{1}}, {{2}} ... directly; variables are auto-detected." style="min-height:220px;"/>
                        </page>
                        <page string="Buttons">
                            <field name="button_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="button_type"/>
                                    <field name="text"/>
                                    <field name="website_url" invisible="button_type != 'url'"/>
                                    <field name="phone_number" invisible="button_type != 'phone'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Variables">
                            <field name="variable_line_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="key" optional="hide"/>
                                    <field name="sample_value"/>
                                    <field name="variable_type"/>
                                    <field name="model_id" invisible="variable_type != 'field'"/>
                                    <field name="field_id" invisible="variable_type != 'field'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval" invisible="not bird_template_id and status == 'draft'">
                            <group>
                                <field name="project_id" readonly="1"/><field name="bird_template_id" readonly="1"/>
                                <field name="version" readonly="1"/><field name="channel_group_id" readonly="1"/>
                                <field name="submitted_at" readonly="1"/><field name="last_status_sync" readonly="1"/>
                                <field name="rejection_reason" readonly="1" invisible="status != 'rejected'"/>
                            </group>
                            <field name="approval_details" widget="ace" options="{'mode':'json'}" readonly="1"/>
                        </page>
                        <page string="Technical" groups="base.group_system">
                            <field name="platform_info" widget="ace" options="{'mode':'json'}" readonly="1"/>
                            <field name="platform_content" widget="ace" options="{'mode':'json'}" readonly="1"/>
                            <field name="deployments" widget="ace" options="{'mode':'json'}" readonly="1"/>
                            <field name="variables" widget="ace" options="{'mode':'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div style="min-width:400px; width:400px; padding:14px 18px; background:#f7f8fa; border-left:1px solid #e5e7eb; overflow:auto; box-sizing:border-box;">
                    <h4 class="text-center" style="font-weight:700; margin:4px 0 12px 0;">WhatsApp Preview</h4>
                    <div style="display:flex;justify-content:center;width:100%;">
                        <field name="preview_html" widget="html" nolabel="1" readonly="1" style="width:352px;min-width:352px;max-width:352px;"/>
                    </div>
                </div>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bird_template_version_list" model="ir.ui.view">
        <field name="name">bird.template.version.list</field>
        <field name="model">bird.template.version</field>
        <field name="arch" type="xml">
            <list string="Template Versions" create="0" edit="0" delete="0">
                <field name="description"/>
                <field name="status" widget="badge" decoration-success="status in ('active','approved')" decoration-warning="status == 'pending'" decoration-danger="status == 'rejected'" decoration-muted="status == 'inactive'"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="publisher"/>
                <field name="last_updated"/>
                <field name="last_updated_by"/>
                <field name="bird_version_id"/>
            </list>
        </field>
    </record>

    <record id="view_bird_template_version_form" model="ir.ui.view">
        <field name="name">bird.template.version.form</field>
        <field name="model">bird.template.version</field>
        <field name="arch" type="xml">
            <form string="Template Version" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="template_id"/><field name="description"/><field name="status"/><field name="is_current"/></group>
                        <group><field name="bird_version_id"/><field name="publisher"/><field name="last_updated"/><field name="last_updated_by"/></group>
                    </group>
                    <field name="raw_json" widget="ace" options="{'mode':'json'}" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
