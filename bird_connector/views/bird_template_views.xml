<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_bird_template_tree" model="ir.ui.view">
        <field name="name">bird.template.tree</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <list string="Bird Templates">
                <field name="name"/>
                <field name="workspace_id"/>
                <field name="template_type"/>
                <field name="status" widget="badge" decoration-success="status=='active'" decoration-warning="status=='draft'" decoration-info="status=='pending'"/>
                <field name="locale"/>
                <field name="version"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bird_template_search" model="ir.ui.view">
        <field name="name">bird.template.search</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <search string="Templates Search">
                <field name="name"/>
                <field name="bird_template_id"/>
                <field name="project_id"/>
                <field name="workspace_id"/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Workspace" name="group_workspace" context="{'group_by': 'workspace_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bird_template_form" model="ir.ui.view">
        <field name="name">bird.template.form</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <form string="Template">
                <header>
                    <button name="action_sync_template" string="Sync Template" type="object" class="btn-secondary"/>
                    <button name="action_open_send_message" string="Send WhatsApp" type="object" class="oe_highlight" invisible="status != 'active'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,draft,pending"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workspace_id"/>
                            <field name="template_type"/>
                            <field name="description"/>
                            <field name="supported_platforms"/>
                            <field name="locales"/>
                            <field name="active_count"/>
                            <field name="inactive_count"/>
                            <field name="draft_count"/>
                        </group>
                        <group>
                            <field name="bird_template_id"/>
                            <field name="project_id"/>
                            <field name="scope"/>
                            <field name="locale"/>
                            <field name="pending_count"/>
                            <field name="active_resource_id"/>
                            <field name="is_cloneable"/>
                            <field name="short_links_enabled"/>
                            <field name="short_links_domain"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Platform Info">
                            <field name="platform_info" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Platform Content">
                            <field name="platform_content" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Deployments">
                            <field name="deployments" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Styles">
                            <field name="styles" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Variables">
                            <field name="variables" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Generic Content">
                            <field name="generic_content" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Rich WhatsApp Preview -->
                <div class="oe_chatter" style="min-width: 390px; max-width: 430px; padding: 18px; background:#f7f8fa;">
                    <h4 class="text-center" style="font-weight:700; margin-bottom:14px;">WhatsApp Preview</h4>
                    <div style="background:#efeae2; border-radius:18px; padding:12px; border:1px solid #d9d3ca; box-shadow:0 3px 14px rgba(0,0,0,.08);">
                        <div style="background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 1px 2px rgba(0,0,0,.16);">
                            <div invisible="not preview_header_image" style="width:100%; background:#f3f4f6;">
                                <field name="preview_header_image" widget="image" nolabel="1" style="width:100%; max-height:260px; object-fit:cover;"/>
                            </div>
                            <div style="padding:12px 14px 8px 14px;">
                                <div invisible="not preview_header_text" style="font-weight:700; color:#111b21; margin-bottom:7px;">
                                    <field name="preview_header_text" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="locale != 'ar'" style="white-space:pre-wrap; direction:rtl; text-align:right; color:#111b21; line-height:1.55; font-size:14px;">
                                    <field name="preview_body_text" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="locale == 'ar'" style="white-space:pre-wrap; direction:ltr; text-align:left; color:#111b21; line-height:1.55; font-size:14px;">
                                    <field name="preview_body_text" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="not preview_footer_text" style="margin-top:9px; color:#667781; font-size:11.5px;">
                                    <field name="preview_footer_text" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                            <div invisible="not preview_button_1 and not preview_button_2 and not preview_button_3" style="border-top:1px solid #e9edef;">
                                <div invisible="not preview_button_1" style="padding:10px; text-align:center; color:#00a884; font-weight:600; border-bottom:1px solid #e9edef;">
                                    <field name="preview_button_1" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="not preview_button_2" style="padding:10px; text-align:center; color:#00a884; font-weight:600; border-bottom:1px solid #e9edef;">
                                    <field name="preview_button_2" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="not preview_button_3" style="padding:10px; text-align:center; color:#00a884; font-weight:600;">
                                    <field name="preview_button_3" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <button name="action_sync_template" string="Sync Preview" type="object" class="btn btn-outline-secondary btn-sm"/>
                    </div>
                </div>
            </form>
        </field>
    </record>

</odoo>