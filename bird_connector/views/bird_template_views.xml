<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bird_template_tree" model="ir.ui.view">
        <field name="name">bird.template.tree</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates" default_order="id desc">
                <field name="name"/>
                <field name="api_name"/>
                <field name="workspace_id"/>
                <field name="category"/>
                <field name="locale"/>
                <field name="source" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status=='active'" decoration-warning="status=='pending'" decoration-danger="status=='rejected'" decoration-muted="status=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_bird_template_search" model="ir.ui.view">
        <field name="name">bird.template.search</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <search string="Templates Search">
                <field name="name"/><field name="api_name"/><field name="workspace_id"/><field name="bird_template_id"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="Pending" name="pending" domain="[('status','=','pending')]"/>
                <filter string="Approved" name="approved" domain="[('status','=','active')]"/>
                <filter string="Rejected" name="rejected" domain="[('status','=','rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'category'}"/>
                    <filter string="Workspace" name="group_workspace" context="{'group_by':'workspace_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bird_template_form" model="ir.ui.view">
        <field name="name">bird.template.form</field>
        <field name="model">bird.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="oe_highlight" invisible="status != 'draft' or source != 'odoo'"/>
                    <button name="action_refresh_approval_status" string="Refresh Status" type="object" class="btn-secondary" invisible="not bird_template_id"/>
                    <button name="action_open_send_message" string="Send Message" type="object" class="oe_highlight" invisible="status != 'active'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="status not in ('active','rejected') or source != 'odoo'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,active,rejected"/>
                </header>
                <sheet>
                    <field name="source" invisible="1"/>
                    <field name="preview_button_1_type" invisible="1"/>
                    <field name="preview_button_2_type" invisible="1"/>
                    <field name="preview_button_3_type" invisible="1"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Example: Order Ready"/></h1></div>
                    <group>
                        <group>
                            <field name="workspace_id" readonly="status != 'draft'"/>
                            <field name="channel_id" readonly="status != 'draft'"/>
                            <field name="api_name" readonly="status != 'draft'" placeholder="order_ready"/>
                            <field name="category" readonly="status != 'draft'"/>
                            <field name="locale" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="header_type" readonly="status != 'draft'"/>
                            <field name="header_text" invisible="header_type != 'text'" readonly="status != 'draft'"/>
                            <field name="header_image" filename="header_image_filename" widget="image" invisible="header_type != 'image'" readonly="status != 'draft'"/>
                            <field name="header_image_filename" invisible="1"/>
                            <field name="header_media_url" invisible="1" readonly="1"/>
                            <field name="header_media_token" invisible="1" readonly="1"/>
                            <field name="footer_text" readonly="status != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Body">
                            <field name="body" nolabel="1" readonly="status != 'draft'" placeholder="Write the WhatsApp template body here. Use {{variable_name}} for variables." style="min-height:220px;"/>
                        </page>
                        <page string="Buttons">
                            <field name="button_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="button_type"/>
                                    <field name="text"/>
                                    <field name="website_url" invisible="button_type != 'url'"/>
                                    <field name="phone_number" invisible="button_type != 'phone'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Variables">
                            <field name="variable_line_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="sample_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval" invisible="not bird_template_id and status == 'draft'">
                            <group>
                                <field name="project_id" readonly="1"/><field name="bird_template_id" readonly="1"/>
                                <field name="version" readonly="1"/><field name="channel_group_id" readonly="1"/>
                                <field name="submitted_at" readonly="1"/><field name="last_status_sync" readonly="1"/>
                                <field name="rejection_reason" readonly="1" invisible="status != 'rejected'"/>
                            </group>
                            <field name="approval_details" widget="ace" options="{'mode':'json'}" readonly="1"/>
                        </page>
                        <page string="Technical" groups="base.group_system">
                            <field name="platform_info" widget="ace" options="{'mode':'json'}" readonly="1"/>
                            <field name="platform_content" widget="ace" options="{'mode':'json'}" readonly="1"/>
                            <field name="deployments" widget="ace" options="{'mode':'json'}" readonly="1"/>
                            <field name="variables" widget="ace" options="{'mode':'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div style="min-width:390px; max-width:430px; padding:14px 18px; background:#f7f8fa; border-left:1px solid #e5e7eb;">
                    <h4 class="text-center" style="font-weight:700; margin:4px 0 12px 0;">WhatsApp Preview</h4>
                    <div style="background:#efeae2; border-radius:14px; padding:12px; border:1px solid #d9d3ca; min-height:420px;">
                        <div style="max-width:320px; margin:0 auto; background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.18);">
                            <div style="background:#075e54; color:#fff; padding:10px 12px; font-weight:700; display:flex; align-items:center; gap:8px;">
                                <span style="display:inline-flex; width:24px; height:24px; border-radius:50%; background:#fff; color:#128c7e; align-items:center; justify-content:center; font-weight:800;">B</span>
                                <span>Bird</span>
                            </div>
                            <div invisible="not preview_header_image">
                                <field name="preview_header_image" widget="image" nolabel="1" readonly="1" style="width:100%; max-height:280px; object-fit:cover; display:block;"/>
                            </div>
                            <div style="padding:10px 12px 8px 12px; background:#fff;">
                                <div invisible="not preview_header_text" style="font-weight:700; font-size:14px; margin-bottom:6px;">
                                    <field name="preview_header_text" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="locale != 'ar'" style="white-space:pre-wrap; direction:rtl; text-align:right; line-height:1.5; font-size:13px; color:#111b21;">
                                    <field name="preview_body_text" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="locale == 'ar'" style="white-space:pre-wrap; direction:ltr; text-align:left; line-height:1.5; font-size:13px; color:#111b21;">
                                    <field name="preview_body_text" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="not preview_footer_text" style="margin-top:7px; color:#667781; font-size:11px;">
                                    <field name="preview_footer_text" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                            <div invisible="not preview_button_1 and not preview_button_2 and not preview_button_3" style="background:#fff; border-top:1px solid #e9edef;">
                                <div invisible="not preview_button_1" style="padding:10px 8px; text-align:center; color:#027eb5; font-size:13px; font-weight:500;">
                                    <span invisible="preview_button_1_type != 'url'" class="fa fa-external-link" style="margin-right:6px;"/>
                                    <span invisible="preview_button_1_type != 'phone'" class="fa fa-phone" style="margin-right:6px;"/>
                                    <span invisible="preview_button_1_type != 'quick_reply'" class="fa fa-reply" style="margin-right:6px;"/>
                                    <field name="preview_button_1" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="not preview_button_2" style="padding:10px 8px; text-align:center; color:#027eb5; font-size:13px; font-weight:500; border-top:1px solid #e9edef;">
                                    <span invisible="preview_button_2_type != 'url'" class="fa fa-external-link" style="margin-right:6px;"/>
                                    <span invisible="preview_button_2_type != 'phone'" class="fa fa-phone" style="margin-right:6px;"/>
                                    <span invisible="preview_button_2_type != 'quick_reply'" class="fa fa-reply" style="margin-right:6px;"/>
                                    <field name="preview_button_2" nolabel="1" readonly="1"/>
                                </div>
                                <div invisible="not preview_button_3" style="padding:10px 8px; text-align:center; color:#027eb5; font-size:13px; font-weight:500; border-top:1px solid #e9edef;">
                                    <span invisible="preview_button_3_type != 'url'" class="fa fa-external-link" style="margin-right:6px;"/>
                                    <span invisible="preview_button_3_type != 'phone'" class="fa fa-phone" style="margin-right:6px;"/>
                                    <span invisible="preview_button_3_type != 'quick_reply'" class="fa fa-reply" style="margin-right:6px;"/>
                                    <field name="preview_button_3" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
