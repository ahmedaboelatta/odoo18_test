            action="bird_connector.action_bird_organization"
            sequence="10"/>

        <menuitem
            id="menu_bird_workspace"
            name="Workspaces"
            parent="menu_bird_connector_root"
            action="bird_connector.action_bird_workspace"
            sequence="20"/>

        <menuitem
            id="menu_bird_channel"
            name="Channels"
            parent="menu_bird_connector_root"
            action="bird_connector.action_bird_channel"
            sequence="30"/>

        <menuitem
            id="menu_bird_contact"
            name="Contacts"
            parent="menu_bird_connector_root"
            action="bird_connector.action_bird_contact"
            sequence="35"/>

        <menuitem
            id="menu_bird_conversation"
            name="Conversations"
            parent="menu_bird_connector_root"
            action="bird_connector.action_bird_conversation_inbox"
