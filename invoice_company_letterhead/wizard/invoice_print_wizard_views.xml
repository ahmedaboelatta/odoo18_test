<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_print_wizard_form" model="ir.ui.view">
        <field name="name">invoice.print.wizard.form</field>
        <field name="model">invoice.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Preview / Print Invoice">
                <group>
                    <field name="move_id" invisible="not move_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="design_id" options="{'no_create': True}"/>
                    <field name="preview_mode" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="not preview_mode">
                        The preview uses sample values only; no accounting entry or invoice is created.
                    </div>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Preview PDF" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print" class="btn-secondary"
                            invisible="preview_mode"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
