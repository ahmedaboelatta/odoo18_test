<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_invoice_letterhead" model="ir.actions.report">
        <field name="name">Print with Company Letterhead</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_company_letterhead.report_invoice_letterhead</field>
        <field name="report_file">invoice_company_letterhead.report_invoice_letterhead</field>
        <field name="print_report_name">'Invoice Letterhead - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_invoice_design_preview" model="ir.actions.report">
        <field name="name">Invoice Design Preview</field>
        <field name="model">invoice.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_company_letterhead.report_invoice_design_preview</field>
        <field name="report_file">invoice_company_letterhead.report_invoice_design_preview</field>
        <field name="print_report_name">'Invoice Design Preview'</field>
    </record>
</odoo>
