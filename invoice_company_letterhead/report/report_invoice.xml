<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each wrapper deliberately calls Odoo's own editable QWeb report. -->
    <template id="report_saleorder_letterhead">
        <t t-call="sale.report_saleorder"/>
    </template>

    <template id="report_delivery_letterhead">
        <t t-call="stock.report_deliveryslip"/>
    </template>

    <template id="report_invoice_letterhead">
        <t t-call="account.report_invoice_with_payments"/>
    </template>

    <template id="report_purchase_letterhead">
        <t t-call="purchase.report_purchaseorder"/>
    </template>

    <!-- Remove Odoo's regular header/footer only for our letterhead print actions. -->
    <template id="external_layout_letterhead_content">
        <div t-attf-class="article o_company_#{company.id}_layout o_company_letterhead_content"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>

    <template id="external_layout_company_pdf_letterhead"
              inherit_id="web.external_layout" priority="999">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before">
            <t t-if="company_letterhead_print and company.invoice_letterhead_enabled and company.invoice_letterhead_pdf"
               t-call="invoice_company_letterhead.external_layout_letterhead_content">
                <t t-out="0"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace">
            <t t-elif="company.external_report_layout_id"
               t-call="{{company.external_report_layout_id.sudo().key}}">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
