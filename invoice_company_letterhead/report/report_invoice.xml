<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="letterhead_report_styles">
        <style>
            @font-face {
                font-family: 'Letterhead Cairo';
                src: url('/gs_vacation_settlement/static/src/fonts/cairo/Cairo-Regular.ttf') format('truetype');
                font-weight: 400;
                font-style: normal;
            }
            @font-face {
                font-family: 'Letterhead Cairo';
                src: url('/gs_vacation_settlement/static/src/fonts/cairo/Cairo-Bold.ttf') format('truetype');
                font-weight: 700;
                font-style: normal;
            }
            .lh-report { font-family: 'DejaVu Sans', Tahoma, Arial, sans-serif; font-size: 10px; color: #111; }
            .lh-report table { width: 100%; border-collapse: collapse; }
            .lh-report .lh-table th, .lh-report .lh-table td { border: 1px solid #222; padding: 5px 6px; vertical-align: middle; }
            .lh-report .lh-table th { background: #eef2f5; font-weight: 700; text-align: center; }
            .lh-report .lh-title { font-size: 22px; font-weight: 700; margin-bottom: 10px; color: #27364a; }
            .lh-report .lh-ar { direction: rtl; unicode-bidi: embed; text-align: right; font-family: 'Letterhead Cairo', 'DejaVu Sans', Tahoma, Arial, sans-serif; }
            .lh-report .lh-title-label { color: #111; font-weight: 700; border-bottom: 3px solid #111; padding: 0 3px 2px; line-height: 1.4; }
            .lh-report .lh-right { text-align: right; }
            .lh-report .lh-center { text-align: center; }
            .lh-report .lh-nowrap { white-space: nowrap; }
            .lh-report .lh-customer { margin-bottom: 10px; }
            .lh-report .lh-label { width: 16%; background: #eef2f5; font-weight: 700; }
            .lh-report .lh-total-label { font-weight: 700; background: #eef2f5; }
            .lh-report .lh-signature { margin-top: 35px; min-height: 90px; }
            .lh-report .lh-address-table { font-size: 8.5px; table-layout: fixed; }
            .lh-report .lh-address-table th, .lh-report .lh-address-table td { padding: 2px 4px; line-height: 1.25; }
            .lh-report .lh-address-table .lh-label { width: 14%; }
            .lh-report .lh-title-table { margin-bottom: 9px; table-layout: fixed; border: 0 !important; }
            .lh-report .lh-title-table tr, .lh-report .lh-title-table td { border: 0 !important; }
            .lh-report .lh-title-table td { padding: 0 3px; vertical-align: bottom; }
            .lh-report .lh-party-layout { width: 100%; table-layout: fixed; margin-bottom: 8px; }
            .lh-report .lh-party-layout .lh-party-slot { width: 50%; border: 0; padding: 0; vertical-align: top; }
            .lh-report .lh-party-layout .lh-party-left { padding-right: 4px; }
            .lh-report .lh-party-layout .lh-party-right { padding-left: 4px; }
            .lh-report .lh-party-card { width: 100%; table-layout: fixed; border: 1px solid #777; background: #fff; }
            .lh-report .lh-party-card .lh-party-heading { padding: 4px 7px; color: #111; background: #fff; border-bottom: 1px solid #777; font-size: 12px; font-weight: 700; text-align: center; }
            .lh-report .lh-party-card td { height: 25px; padding: 1px 5px; line-height: 1.15; border: 0; border-bottom: 1px solid #999; box-sizing: border-box; }
            .lh-report .lh-party-card th { height: 22px; box-sizing: border-box; }
            .lh-report .lh-party-card tr:last-child td { border-bottom: 0; }
            .lh-report .lh-party-card .lh-party-label { background: #e2e2e2; font-weight: 700; text-align: center; direction: rtl; font-family: 'Letterhead Cairo', 'DejaVu Sans', sans-serif; }
            .lh-report .lh-party-card .lh-party-heading { font-family: 'Letterhead Cairo', 'DejaVu Sans', sans-serif; }
            .lh-report .lh-party-card .lh-party-value { text-align: center; }
            .lh-report .lh-meta-table { table-layout: fixed; margin-bottom: 9px; }
            .lh-report .lh-meta-table th { padding: 3px 4px; line-height: 1.3; background: #dedede; border: 1px dotted #888; }
            .lh-report .lh-meta-table td { padding: 4px; text-align: center; border: 1px dotted #888; font-weight: 600; }
            .lh-report .lh-invoice-number { display: inline-block; margin-top: 1px; font-size: 16px; line-height: 1.1; font-weight: 700; }
            .lh-report .lh-invoice-title { width: 100%; margin-bottom: 9px; overflow: hidden; border: 0 !important; outline: 0 !important; }
            .lh-report .lh-invoice-title-left { float: left; width: 32%; text-align: left; }
            .lh-report .lh-invoice-title-center { float: left; width: 36%; text-align: center; font-size: 10px; line-height: 1.25; }
            .lh-report .lh-invoice-title-right { float: right; width: 32%; text-align: right; }
            .lh-report .lh-invoice-title .lh-title-label { border-bottom: 0 !important; }
        </style>
    </template>

    <!-- Customer invoice and vendor bill body. -->
    <template id="report_invoice_letterhead_document">
        <t t-call="web.external_layout">
            <t t-set="company" t-value="o.company_id"/>
            <t t-call="invoice_company_letterhead.letterhead_report_styles"/>
            <div class="page lh-report">
                <div class="lh-title lh-invoice-title">
                    <div class="lh-invoice-title-left"><span class="lh-title-label" t-if="o.move_type in ('out_invoice', 'out_receipt')">Tax Invoice</span><span class="lh-title-label" t-elif="o.move_type == 'out_refund'">Credit Note</span><span class="lh-title-label" t-elif="o.move_type in ('in_invoice', 'in_receipt')">Vendor Bill</span><span class="lh-title-label" t-else="">Vendor Credit Note</span></div>
                    <div class="lh-invoice-title-center">Invoice No. / <span class="lh-ar">رقم الفاتورة</span><br/><span class="lh-invoice-number" t-out="o.name or ''"/></div>
                    <div class="lh-invoice-title-right lh-ar"><span class="lh-title-label">
                        <t t-if="o.move_type in ('out_invoice', 'out_receipt')">فاتورة ضريبية</t>
                        <t t-elif="o.move_type == 'out_refund'">إشعار دائن</t>
                        <t t-elif="o.move_type in ('in_invoice', 'in_receipt')">فاتورة مورد</t>
                        <t t-else="">إشعار دائن مورد</t>
                    </span></div>
                </div>

                <t t-set="partner_address" t-value="o.partner_id._get_letterhead_address_values()"/>
                <t t-set="company_address" t-value="company.partner_id._get_letterhead_address_values()"/>
                <table class="lh-party-layout"><tr>
                    <td class="lh-party-slot lh-party-left"><table class="lh-party-card">
                        <colgroup><col style="width:30%"/><col style="width:20%"/><col style="width:30%"/><col style="width:20%"/></colgroup>
                        <tr><th colspan="4" class="lh-party-heading"><t t-if="o.move_type in ('in_invoice','in_refund','in_receipt')">Vendor Details / <span class="lh-ar">تفاصيل المورد</span></t><t t-else="">Customer Company Details / <span class="lh-ar">تفاصيل شركة العميل</span></t></th></tr>
                        <tr><td colspan="3" class="lh-party-value" t-out="o.partner_id.name or ''"/><td class="lh-party-label">الاسم<br/><small>Name</small></td></tr>
                        <tr><td colspan="3" class="lh-party-value" t-out="partner_address['street']"/><td class="lh-party-label">اسم الشارع<br/><small>Street Name</small></td></tr>
                        <tr><td class="lh-party-value" t-out="partner_address['city']"/><td class="lh-party-label">المدينة<br/><small>City</small></td><td class="lh-party-value" t-out="partner_address['building_no']"/><td class="lh-party-label">رقم المبنى<br/><small>Building No</small></td></tr>
                        <tr><td class="lh-party-value" t-out="partner_address['district']"/><td class="lh-party-label">الحي<br/><small>District</small></td><td class="lh-party-value" t-out="partner_address['additional_no']"/><td class="lh-party-label">الرقم الإضافي<br/><small>Addl. No</small></td></tr>
                        <tr><td class="lh-party-value" t-out="partner_address['country']"/><td class="lh-party-label">البلد<br/><small>Country</small></td><td class="lh-party-value" t-out="partner_address['postal_code']"/><td class="lh-party-label">الرمز البريدي<br/><small>Postal Code</small></td></tr>
                        <tr><td class="lh-party-value" t-out="partner_address['crn']"/><td class="lh-party-label">معرف آخر<br/><small>CRN</small></td><td class="lh-party-value" t-out="partner_address['vat']"/><td class="lh-party-label">الرقم الضريبي<br/><small>VAT Number</small></td></tr>
                    </table></td>
                    <td class="lh-party-slot lh-party-right"><table class="lh-party-card">
                        <colgroup><col style="width:30%"/><col style="width:20%"/><col style="width:30%"/><col style="width:20%"/></colgroup>
                        <tr><th colspan="4" class="lh-party-heading">Our Company Details / <span class="lh-ar">تفاصيل شركتنا</span></th></tr>
                        <tr><td colspan="3" class="lh-party-value" t-out="company.name or ''"/><td class="lh-party-label">الاسم<br/><small>Name</small></td></tr>
                        <tr><td colspan="3" class="lh-party-value" t-out="company_address['street']"/><td class="lh-party-label">اسم الشارع<br/><small>Street Name</small></td></tr>
                        <tr><td class="lh-party-value" t-out="company_address['city']"/><td class="lh-party-label">المدينة<br/><small>City</small></td><td class="lh-party-value" t-out="company_address['building_no']"/><td class="lh-party-label">رقم المبنى<br/><small>Building No</small></td></tr>
                        <tr><td class="lh-party-value" t-out="company_address['district']"/><td class="lh-party-label">الحي<br/><small>District</small></td><td class="lh-party-value" t-out="company_address['additional_no']"/><td class="lh-party-label">الرقم الإضافي<br/><small>Addl. No</small></td></tr>
                        <tr><td class="lh-party-value" t-out="company_address['country']"/><td class="lh-party-label">البلد<br/><small>Country</small></td><td class="lh-party-value" t-out="company_address['postal_code']"/><td class="lh-party-label">الرمز البريدي<br/><small>Postal Code</small></td></tr>
                        <tr><td class="lh-party-value" t-out="company.company_registry or company_address['crn']"/><td class="lh-party-label">معرف آخر<br/><small>CRN</small></td><td class="lh-party-value" t-out="company.vat or company_address['vat']"/><td class="lh-party-label">الرقم الضريبي<br/><small>VAT Number</small></td></tr>
                    </table></td>
                </tr></table>
                <table class="lh-meta-table">
                    <thead><tr>
                        <th>تاريخ الفاتورة<br/><small>Invoice Date</small></th>
                        <th>تاريخ الاستحقاق<br/><small>Due Date</small></th>
                        <th>تاريخ التوريد<br/><small>Supply Date</small></th>
                        <th>المصدر<br/><small>Source</small></th>
                        <th>المرجع<br/><small>Reference</small></th>
                    </tr></thead>
                    <tbody><tr>
                        <td t-out="o.invoice_date or ''"/>
                        <td t-out="o.invoice_date_due or ''"/>
                        <td t-out="o.delivery_date or ''"/>
                        <td t-out="o.invoice_origin or ''"/>
                        <td t-out="o.ref or ''"/>
                    </tr></tbody>
                </table>

                <t t-set="product_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type in (False, 'product'))"/>
                <table class="lh-table">
                    <thead><tr>
                        <th style="width:5%">#</th>
                        <th style="width:29%">Product<br/><span class="lh-ar">المنتج</span></th>
                        <th style="width:8%">Qty<br/><span class="lh-ar">الكمية</span></th>
                        <th style="width:10%">UOM<br/><span class="lh-ar">وحدة القياس</span></th>
                        <th style="width:12%">Unit Price<br/><span class="lh-ar">سعر الوحدة</span></th>
                        <th style="width:8%">Taxes<br/><span class="lh-ar">الضرائب</span></th>
                        <th style="width:15%">Subtotal<br/><span class="lh-ar">الإجمالي قبل الضريبة</span></th>
                        <th style="width:13%">Total<br/><span class="lh-ar">الإجمالي</span></th>
                    </tr></thead>
                    <tbody>
                        <tr t-foreach="product_lines" t-as="line">
                            <td class="lh-center" t-out="line_index + 1"/>
                            <td><span t-out="line.product_id.display_name or line.name"/></td>
                            <td class="lh-center"><span t-field="line.quantity"/></td>
                            <td class="lh-center"><span t-field="line.product_uom_id"/></td>
                            <td class="lh-right"><span t-out="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                            <td class="lh-center" t-out="', '.join(line.tax_ids.mapped('name'))"/>
                            <td class="lh-right"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                            <td class="lh-right"><span t-field="line.price_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-2">
                    <div class="col-8">
                        <table class="lh-table">
                            <tr><td class="lh-total-label">Untaxed Amount / الإجمالي قبل الضريبة</td><td class="lh-right"><span t-field="o.amount_untaxed" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                            <tr><td class="lh-total-label">VAT / ضريبة القيمة المضافة</td><td class="lh-right"><span t-field="o.amount_tax" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                            <tr><td class="lh-total-label">Total / الإجمالي شامل الضريبة</td><td class="lh-right"><b t-field="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                        </table>
                        <t t-set="reconciled_payments" t-value="o.reconciled_payment_ids"/>
                        <table class="lh-table mt-2" t-if="reconciled_payments or o.payment_state in ('paid', 'partial', 'in_payment')">
                            <tr t-foreach="reconciled_payments" t-as="payment">
                                <td class="lh-total-label">Paid Via / <span class="lh-ar">طريقة الدفع الفعلية</span></td>
                                <td>
                                    <span t-out="payment.journal_id.name or ''"/>
                                    <span t-if="payment.payment_method_line_id"> (<span t-out="payment.payment_method_line_id.name"/>)</span>
                                    <span> — </span><span t-field="payment.date"/>
                                    <span> — </span><span t-field="payment.amount" t-options="{'widget':'monetary','display_currency':payment.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-if="o.payment_state in ('paid', 'partial', 'in_payment')"><td class="lh-total-label">Amount Due / <span class="lh-ar">المبلغ المتبقي</span></td><td><span t-field="o.amount_residual" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                        </table>
                    </div>
                    <div class="col-4 lh-center">
                        <t t-if="'qr_code_image' in o._fields and o.qr_code_image">
                            <img t-att-src="'data:image/png;base64,%s' % o.qr_code_image" style="width:145px;height:145px" alt="ZATCA QR Code"/>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_invoice_letterhead">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="invoice_company_letterhead.report_invoice_letterhead_document" t-lang="o.partner_id.lang"/></t></t>
    </template>

    <!-- Quotation and sales order body. -->
    <template id="report_saleorder_letterhead_document">
        <t t-call="web.external_layout">
            <t t-set="company" t-value="o.company_id"/>
            <t t-call="invoice_company_letterhead.letterhead_report_styles"/>
            <div class="page lh-report">
                <div class="lh-title"><span class="lh-title-label" t-if="o.state in ('draft','sent')">Quotation</span><span class="lh-title-label" t-else="">Sales Order</span><span class="float-end lh-ar lh-title-label"><t t-if="o.state in ('draft','sent')">عرض سعر</t><t t-else="">أمر بيع</t></span></div>
                <table class="lh-table lh-customer">
                    <tr><td class="lh-label">Customer Name<br/><span class="lh-ar">اسم العميل</span></td><td t-out="o.partner_id.name or ''"/><td class="lh-label">Reference<br/><span class="lh-ar">المرجع</span></td><td t-out="o.name or ''"/></tr>
                    <tr><td class="lh-label">National Address<br/><span class="lh-ar">العنوان الوطني</span></td><td t-out="o.partner_id.contact_address or ''"/><td class="lh-label">Quotation Date<br/><span class="lh-ar">تاريخ العرض</span></td><td t-out="o.date_order or ''"/></tr>
                    <tr><td class="lh-label">VAT Number<br/><span class="lh-ar">الرقم الضريبي</span></td><td t-out="o.partner_id.vat or ''"/><td class="lh-label">Expiry Date<br/><span class="lh-ar">تاريخ انتهاء العرض</span></td><td t-out="o.validity_date or ''"/></tr>
                    <tr><td class="lh-label">Payment Terms<br/><span class="lh-ar">طريقة الدفع</span></td><td t-out="o.payment_term_id.name or ''"/><td class="lh-label">Customer Reference<br/><span class="lh-ar">مرجع العميل</span></td><td t-out="o.client_order_ref or ''"/></tr>
                </table>
                <t t-set="product_lines" t-value="o.order_line.filtered(lambda l: not l.display_type)"/>
                <table class="lh-table">
                    <thead><tr><th>#</th><th>Product<br/><span class="lh-ar">المنتج</span></th><th>Qty<br/><span class="lh-ar">الكمية</span></th><th>Unit Price<br/><span class="lh-ar">سعر الوحدة</span></th><th>Discount<br/><span class="lh-ar">الخصم</span></th><th>Taxes<br/><span class="lh-ar">الضرائب</span></th><th>Subtotal<br/><span class="lh-ar">الإجمالي</span></th></tr></thead>
                    <tbody><tr t-foreach="product_lines" t-as="line"><td class="lh-center" t-out="line_index + 1"/><td t-out="line.product_id.display_name or line.name"/><td class="lh-center"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom"/></td><td class="lh-right"><span t-field="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td><td class="lh-center"><span t-field="line.discount"/>%</td><td class="lh-center" t-out="', '.join(line.tax_id.mapped('name'))"/><td class="lh-right"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr></tbody>
                </table>
                <div class="row justify-content-end mt-2"><div class="col-5"><table class="lh-table"><tr><td class="lh-total-label">Untaxed / قبل الضريبة</td><td class="lh-right"><span t-field="o.amount_untaxed" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr><tr><td class="lh-total-label">VAT / الضريبة</td><td class="lh-right"><span t-field="o.amount_tax" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr><tr><td class="lh-total-label">Total / الإجمالي</td><td class="lh-right"><b t-field="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr></table></div></div>
                <div class="mt-3" t-if="o.note"><b>Terms and Conditions / الشروط والأحكام</b><div t-field="o.note"/></div>
            </div>
        </t>
    </template>

    <template id="report_saleorder_letterhead">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="invoice_company_letterhead.report_saleorder_letterhead_document" t-lang="o.partner_id.lang"/></t></t>
    </template>

    <!-- Delivery slip body. -->
    <template id="report_delivery_letterhead_document">
        <t t-call="web.external_layout">
            <t t-set="company" t-value="o.company_id"/>
            <t t-call="invoice_company_letterhead.letterhead_report_styles"/>
            <div class="page lh-report">
                <div class="lh-title"><span class="lh-title-label">Delivery Slip</span><span class="float-end lh-ar lh-title-label">إذن تسليم</span></div>
                <table class="lh-table lh-customer">
                    <tr><td class="lh-label">Customer Name<br/><span class="lh-ar">اسم العميل</span></td><td t-out="o.partner_id.name or ''"/><td class="lh-label">Delivery No.<br/><span class="lh-ar">رقم التسليم</span></td><td t-out="o.name or ''"/></tr>
                    <tr><td class="lh-label">National Address<br/><span class="lh-ar">العنوان الوطني</span></td><td t-out="o.partner_id.contact_address or ''"/><td class="lh-label">Scheduled Date<br/><span class="lh-ar">تاريخ التسليم</span></td><td t-out="o.scheduled_date or ''"/></tr>
                    <tr><td class="lh-label">VAT Number<br/><span class="lh-ar">الرقم الضريبي</span></td><td t-out="o.partner_id.vat or ''"/><td class="lh-label">Source<br/><span class="lh-ar">المصدر</span></td><td t-out="o.origin or ''"/></tr>
                </table>
                <t t-set="delivery_lines" t-value="o.move_ids.filtered(lambda m: m.state != 'cancel')"/>
                <table class="lh-table">
                    <thead><tr><th>#</th><th>Product<br/><span class="lh-ar">المنتج</span></th><th>Ordered Qty<br/><span class="lh-ar">الكمية المطلوبة</span></th><th>Delivered Qty<br/><span class="lh-ar">الكمية المسلمة</span></th><th>Unit<br/><span class="lh-ar">الوحدة</span></th></tr></thead>
                    <tbody><tr t-foreach="delivery_lines" t-as="line"><td class="lh-center" t-out="line_index + 1"/><td t-out="line.product_id.display_name or line.name"/><td class="lh-center"><span t-field="line.product_uom_qty"/></td><td class="lh-center"><span t-field="line.quantity"/></td><td class="lh-center"><span t-field="line.product_uom"/></td></tr></tbody>
                </table>
                <table class="lh-table lh-signature">
                    <tr><th>Prepared By / أعد بواسطة</th><th>Received By / استلم بواسطة</th></tr>
                    <tr><td style="height:70px">Name / الاسم:<br/><br/>Signature / التوقيع:</td><td>Name / الاسم:<br/><br/>Signature / توقيع المستلم:</td></tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_delivery_letterhead">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="invoice_company_letterhead.report_delivery_letterhead_document" t-lang="o.partner_id.lang"/></t></t>
    </template>

    <!-- RFQ and purchase order body. -->
    <template id="report_purchase_letterhead_document">
        <t t-call="web.external_layout">
            <t t-set="company" t-value="o.company_id"/>
            <t t-call="invoice_company_letterhead.letterhead_report_styles"/>
            <div class="page lh-report">
                <div class="lh-title">
                    <span class="lh-title-label" t-if="o.state in ('draft', 'sent', 'to approve')">Request for Quotation</span>
                    <span class="lh-title-label" t-else="">Purchase Order</span>
                    <span class="float-end lh-ar lh-title-label"><t t-if="o.state in ('draft', 'sent', 'to approve')">طلب عرض سعر</t><t t-else="">أمر شراء</t></span>
                </div>
                <table class="lh-table lh-customer">
                    <tr><td class="lh-label">Vendor Name<br/><span class="lh-ar">اسم المورد</span></td><td t-out="o.partner_id.name or ''"/><td class="lh-label">Reference<br/><span class="lh-ar">المرجع</span></td><td t-out="o.name or ''"/></tr>
                    <tr><td class="lh-label">National Address<br/><span class="lh-ar">العنوان الوطني</span></td><td t-out="o.partner_id.contact_address or ''"/><td class="lh-label">Order Date<br/><span class="lh-ar">تاريخ الطلب</span></td><td t-out="o.date_order or ''"/></tr>
                    <tr><td class="lh-label">VAT Number<br/><span class="lh-ar">الرقم الضريبي</span></td><td t-out="o.partner_id.vat or ''"/><td class="lh-label">Expected Arrival<br/><span class="lh-ar">تاريخ الوصول المتوقع</span></td><td t-out="o.date_planned or ''"/></tr>
                    <tr><td class="lh-label">Payment Terms<br/><span class="lh-ar">طريقة الدفع</span></td><td t-out="o.payment_term_id.name or ''"/><td class="lh-label">Vendor Reference<br/><span class="lh-ar">مرجع المورد</span></td><td t-out="o.partner_ref or ''"/></tr>
                </table>
                <t t-set="purchase_lines" t-value="o.order_line.filtered(lambda l: not l.display_type)"/>
                <table class="lh-table">
                    <thead><tr><th>#</th><th>Product<br/><span class="lh-ar">المنتج</span></th><th>Qty<br/><span class="lh-ar">الكمية</span></th><th>Unit Price<br/><span class="lh-ar">سعر الوحدة</span></th><th>Discount<br/><span class="lh-ar">الخصم</span></th><th>Taxes<br/><span class="lh-ar">الضرائب</span></th><th>Subtotal<br/><span class="lh-ar">الإجمالي</span></th></tr></thead>
                    <tbody>
                        <tr t-foreach="purchase_lines" t-as="line">
                            <td class="lh-center" t-out="line_index + 1"/>
                            <td t-out="line.product_id.display_name or line.name"/>
                            <td class="lh-center"><span t-field="line.product_qty"/> <span t-field="line.product_uom"/></td>
                            <td class="lh-right"><span t-field="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                            <td class="lh-center"><span t-out="line.discount if 'discount' in line._fields else 0.0"/>%</td>
                            <td class="lh-center" t-out="', '.join(line.taxes_id.mapped('name'))"/>
                            <td class="lh-right"><span t-field="line.price_subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end mt-2"><div class="col-5"><table class="lh-table"><tr><td class="lh-total-label">Untaxed / قبل الضريبة</td><td class="lh-right"><span t-field="o.amount_untaxed" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr><tr><td class="lh-total-label">VAT / الضريبة</td><td class="lh-right"><span t-field="o.amount_tax" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr><tr><td class="lh-total-label">Total / الإجمالي</td><td class="lh-right"><b t-field="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr></table></div></div>
                <div class="mt-3" t-if="o.notes"><b>Terms and Conditions / الشروط والأحكام</b><div t-field="o.notes"/></div>
            </div>
        </t>
    </template>

    <template id="report_purchase_letterhead">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="invoice_company_letterhead.report_purchase_letterhead_document" t-lang="o.partner_id.lang"/></t></t>
    </template>

    <template id="external_layout_letterhead_content">
        <div t-attf-class="article o_company_#{company.id}_layout o_company_letterhead_content" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')"><t t-out="0"/></div>
    </template>
    <template id="external_layout_company_pdf_letterhead" inherit_id="web.external_layout" priority="999">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before"><t t-if="company_letterhead_print and company.invoice_letterhead_enabled and company.invoice_letterhead_pdf" t-call="invoice_company_letterhead.external_layout_letterhead_content"><t t-out="0"/></t></xpath>
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace"><t t-elif="company.external_report_layout_id" t-call="{{company.external_report_layout_id.sudo().key}}"><t t-out="0"/></t></xpath>
    </template>
</odoo>
