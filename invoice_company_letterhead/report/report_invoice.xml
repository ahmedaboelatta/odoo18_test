<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_letterhead">
        <t t-call="account.report_invoice_with_payments"/>
    </template>

    <template id="external_layout_invoice_letterhead_content">
        <style>
            @page {
                margin-top: 0mm !important;
                margin-bottom: 0mm !important;
            }
            .o_letterhead_page_safe {
                box-sizing: border-box;
                width: 100%;
                min-height: 297mm;
                padding-top: <t t-esc="company.invoice_letterhead_top_offset or 0.0"/>mm;
                padding-bottom: <t t-esc="company.invoice_letterhead_bottom_offset or 0.0"/>mm;
            }
            .o_letterhead_page_safe .page {
                box-sizing: border-box;
                min-height: calc(
                    297mm
                    - <t t-esc="company.invoice_letterhead_top_offset or 0.0"/>mm
                    - <t t-esc="company.invoice_letterhead_bottom_offset or 0.0"/>mm
                );
            }
            .o_letterhead_page_safe table tr,
            .o_letterhead_page_safe .invoice_tbody tr {
                page-break-inside: avoid !important;
            }
        </style>

        <div t-attf-class="article o_company_#{company.id}_layout o_letterhead_page_safe"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>

    <template id="external_layout_company_pdf_letterhead"
              inherit_id="web.external_layout"
              priority="999">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before">
            <t t-if="company_letterhead_print
                     and o
                     and o._name == 'account.move'
                     and o.company_id.invoice_letterhead_enabled
                     and o.company_id.invoice_letterhead_pdf"
               t-call="invoice_company_letterhead.external_layout_invoice_letterhead_content">
                <t t-out="0"/>
            </t>
        </xpath>

        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace">
            <t t-elif="company.external_report_layout_id"
               t-call="{{company.external_report_layout_id.sudo().key}}">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
