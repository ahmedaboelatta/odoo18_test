<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_letterhead">
        <t t-call="account.report_invoice_with_payments"/>
    </template>

    <!--
      Letterhead-only external layout dispatcher.
      The company can choose a dedicated layout independently from its normal
      Document Layout. The selected Odoo layout is called so its invoice styling
      remains available, while CSS hides its header/footer because the uploaded
      PDF is the stationery.
    -->
    <template id="external_layout_invoice_letterhead_dispatcher">
        <t t-set="lh_layout"
           t-value="company.invoice_letterhead_layout or 'default'"/>

        <style>
            .o_invoice_letterhead_render .header,
            .o_invoice_letterhead_render .footer {
                display: none !important;
            }
        </style>

        <div class="o_invoice_letterhead_render">
            <t t-if="lh_layout == 'default'">
                <t t-call="{{company.external_report_layout_id.sudo().key}}">
                    <t t-out="0"/>
                </t>
            </t>
            <t t-else="">
                <t t-call="{{lh_layout}}">
                    <t t-out="0"/>
                </t>
            </t>
        </div>
    </template>

    <!-- Intercept only the separate letterhead print. -->
    <template id="external_layout_company_pdf_letterhead"
              inherit_id="web.external_layout"
              priority="999">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before">
            <t t-if="company_letterhead_print
                     and o
                     and o._name == 'account.move'
                     and o.company_id.invoice_letterhead_enabled
                     and o.company_id.invoice_letterhead_pdf"
               t-call="invoice_company_letterhead.external_layout_invoice_letterhead_dispatcher">
                <t t-out="0"/>
            </t>
        </xpath>

        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace">
            <t t-elif="company.external_report_layout_id"
               t-call="{{company.external_report_layout_id.sudo().key}}">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
