<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Unique report entry point for the extra Print action.
         It still calls Odoo's standard invoice report, preserving the invoice body,
         localization, Saudi/ZATCA QR/barcode, taxes, custom invoice fields, etc. -->
    <template id="report_invoice_letterhead">
        <t t-call="account.report_invoice_with_payments"/>
    </template>

    <!-- Body-only layout used ONLY while rendering the unique letterhead report. -->
    <template id="external_layout_invoice_letterhead_content">
        <div t-attf-class="article o_company_#{company.id}_layout o_invoice_letterhead_content"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')"
             t-att-style="'padding-top:%smm; padding-bottom:%smm;' % (
                 company.invoice_letterhead_top_offset or 0.0,
                 company.invoice_letterhead_bottom_offset or 0.0
             )">
            <t t-out="0"/>
        </div>
    </template>

    <!-- Intercept web.external_layout only for our separate print action.
         Normal Odoo Print > PDF is untouched. -->
    <template id="external_layout_company_pdf_letterhead"
              inherit_id="web.external_layout"
              priority="999">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before">
            <t t-if="company_letterhead_print
                     and o
                     and o._name == 'account.move'
                     and o.company_id.invoice_letterhead_enabled
                     and o.company_id.invoice_letterhead_pdf"
               t-call="invoice_company_letterhead.external_layout_invoice_letterhead_content">
                <t t-out="0"/>
            </t>
        </xpath>

        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="replace">
            <t t-elif="company.external_report_layout_id"
               t-call="{{company.external_report_layout_id.sudo().key}}">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>
</odoo>
