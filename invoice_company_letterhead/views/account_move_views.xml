<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_design" model="ir.ui.view">
        <field name="name">account.move.form.invoice.design</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_invoice_print_wizard" type="object"
                        string="Preview / Print" class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>
