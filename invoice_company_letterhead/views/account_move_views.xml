<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_letterhead_journal_entry" model="ir.ui.view">
        <field name="name">account.move.form.letterhead.journal.entry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="%(action_report_journal_entry_letterhead)d"
                        type="action" string="Print Journal Entry"
                        icon="fa-print" class="btn-secondary"
                        invisible="move_type != 'entry' or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
