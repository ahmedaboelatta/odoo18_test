<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_invoice_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.invoice.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Invoice Letterhead">
                    <group>
                        <field name="invoice_letterhead_enabled"/>
                        <field name="invoice_letterhead_top_offset"
                               invisible="not invoice_letterhead_enabled"/>
                        <field name="invoice_letterhead_bottom_offset"
                               invisible="not invoice_letterhead_enabled"/>
                    </group>
                    <group invisible="not invoice_letterhead_enabled">
                        <field name="invoice_letterhead_layout" invisible="not invoice_letterhead_enabled"/>
                        <field name="invoice_letterhead_pdf"
                               filename="invoice_letterhead_filename"
                               widget="binary"/>
                        <field name="invoice_letterhead_filename" invisible="1"/>
                        <button name="action_preview_invoice_letterhead"
                                type="object"
                                string="Preview Letterhead PDF"
                                class="btn-secondary"
                                invisible="not invoice_letterhead_pdf"/>
                        <div class="text-muted">
                            Upload an A4 PDF. One page is repeated on every invoice page. Multi-page PDFs can be used for first/continuation page designs.
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
