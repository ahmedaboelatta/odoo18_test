<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_invoice_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.invoice.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Invoice Print Designs">
                        <field name="invoice_design_ids" context="{'default_company_id': id}">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="layout"/>
                                <field name="is_default"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
