<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_invoice_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.invoice.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Company Letterhead">
                        <group>
                            <group string="One Letterhead for This Company">
                                <field name="invoice_letterhead_enabled"/>
                                <field name="invoice_letterhead_pdf"
                                       filename="invoice_letterhead_filename"
                                       widget="binary" invisible="not invoice_letterhead_enabled"/>
                                <field name="invoice_letterhead_filename" invisible="1"/>
                                <button name="action_preview_invoice_letterhead" type="object"
                                        string="Preview Letterhead PDF" class="btn-secondary"
                                        invisible="not invoice_letterhead_pdf"/>
                            </group>
                            <group string="Printable Area">
                                <field name="invoice_letterhead_top_offset"
                                       invisible="not invoice_letterhead_enabled"/>
                                <field name="invoice_letterhead_bottom_offset"
                                       invisible="not invoice_letterhead_enabled"/>
                                <div class="text-muted" invisible="not invoice_letterhead_enabled">
                                    These margins are shared by all letterhead reports. Increase them to keep content below the header and above the footer.
                                </div>
                            </group>
                        </group>
                        <separator string="Edit QWeb Report Templates"/>
                        <div class="alert alert-info" role="alert">
                            The company has one PDF letterhead. Each document type keeps its own QWeb body and can be edited separately below.
                        </div>
                        <group groups="base.group_system">
                            <group string="Sales and Delivery">
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Quotation / Sales Order QWeb" class="btn-secondary"
                                        context="{'letterhead_qweb_xmlid': 'sale.report_saleorder_document'}"/>
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Delivery Slip QWeb" class="btn-secondary"
                                        context="{'letterhead_qweb_xmlid': 'stock.report_delivery_document'}"/>
                            </group>
                            <group string="Accounting and Purchase">
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Customer Invoice / Vendor Bill QWeb" class="btn-secondary"
                                        context="{'letterhead_qweb_xmlid': 'account.report_invoice_document'}"/>
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="RFQ / Purchase Order QWeb" class="btn-secondary"
                                        context="{'letterhead_qweb_xmlid': 'purchase.report_purchaseorder_document'}"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
