<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_invoice_letterhead" model="ir.ui.view">
        <field name="name">res.company.form.invoice.letterhead</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                    <page string="Company Letterhead" name="company_letterhead">
                        <group>
                            <group string="Company Letterhead File">
                                <field name="invoice_letterhead_enabled"/>
                                <field name="invoice_letterhead_filename" invisible="1"/>
                                <label for="invoice_letterhead_pdf" invisible="not invoice_letterhead_enabled"/>
                                <div class="o_row" invisible="not invoice_letterhead_enabled">
                                    <field name="invoice_letterhead_pdf" filename="invoice_letterhead_filename"
                                           widget="binary" nolabel="1" class="flex-grow-1"/>
                                    <button name="action_preview_invoice_letterhead" type="object"
                                            string="Preview Portrait" icon="fa-eye" class="btn-secondary ms-2"
                                            invisible="not invoice_letterhead_pdf"/>
                                </div>
                                <label for="landscape_letterhead_pdf" invisible="not invoice_letterhead_enabled"/>
                                <div class="o_row" invisible="not invoice_letterhead_enabled">
                                    <field name="landscape_letterhead_pdf" widget="binary" nolabel="1"
                                           class="flex-grow-1"/>
                                    <button name="action_preview_landscape_letterhead" type="object"
                                            string="Preview Landscape" icon="fa-eye"
                                            class="btn-secondary ms-2"
                                            invisible="not landscape_letterhead_pdf"/>
                                </div>
                            </group>
                            <group string="Printable Area">
                                <field name="invoice_letterhead_top_offset"
                                       invisible="not invoice_letterhead_enabled"/>
                                <field name="invoice_letterhead_bottom_offset"
                                       invisible="not invoice_letterhead_enabled"/>
                                <div class="text-muted" invisible="not invoice_letterhead_enabled">
                                    These margins are shared by all letterhead reports. Increase them to keep content below the header and above the footer.
                                </div>
                            </group>
                        </group>
                        <separator string="Edit QWeb Report Templates"/>
                        <div class="alert alert-info" role="alert">
                            The company can use separate portrait and landscape PDF letterheads. Each report keeps its own editable QWeb body.
                        </div>
                        <div class="alert alert-warning" role="alert" groups="base.group_system">
                            <i class="fa fa-warning me-1"/> QWeb templates are technical settings. Invalid XML may prevent the related report from printing.
                        </div>
                        <group groups="base.group_system">
                            <group string="Sales and Delivery">
                                <div class="d-grid gap-2 w-100">
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Quotation / Sales Order" icon="fa-file-text-o" class="btn-secondary w-100 text-start"
                                        context="{'letterhead_qweb_xmlid': 'invoice_company_letterhead.report_saleorder_letterhead_document'}"/>
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Delivery Slip" icon="fa-truck" class="btn-secondary w-100 text-start"
                                        context="{'letterhead_qweb_xmlid': 'invoice_company_letterhead.report_delivery_letterhead_document'}"/>
                                </div>
                            </group>
                            <group string="Accounting and Purchase">
                                <div class="d-grid gap-2 w-100">
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Customer Invoice / Vendor Bill" icon="fa-file-text-o" class="btn-secondary w-100 text-start"
                                        context="{'letterhead_qweb_xmlid': 'invoice_company_letterhead.report_invoice_letterhead_document'}"/>
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="RFQ / Purchase Order" icon="fa-shopping-cart" class="btn-secondary w-100 text-start"
                                        context="{'letterhead_qweb_xmlid': 'invoice_company_letterhead.report_purchase_letterhead_document'}"/>
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Payment / Receipt Voucher" icon="fa-money" class="btn-secondary w-100 text-start"
                                        context="{'letterhead_qweb_xmlid': 'invoice_company_letterhead.report_payment_voucher_letterhead_document'}"/>
                                <button name="action_edit_letterhead_qweb" type="object"
                                        string="Journal Entry (Landscape)" icon="fa-book" class="btn-secondary w-100 text-start"
                                        context="{'letterhead_qweb_xmlid': 'invoice_company_letterhead.report_journal_entry_letterhead_document'}"/>
                                </div>
                            </group>
                        </group>
                    </page>
            </xpath>
        </field>
    </record>
</odoo>
