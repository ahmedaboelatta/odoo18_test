<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_letterhead_voucher" model="ir.ui.view">
        <field name="name">account.payment.form.letterhead.voucher</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="%(action_report_payment_voucher_letterhead)d"
                        type="action"
                        string="Print Voucher"
                        class="btn-secondary"
                        invisible="state != 'paid' and not (payment_type == 'outbound' and state == 'in_process')"/>
            </xpath>
        </field>
    </record>
</odoo>
