<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_letterhead_design_form" model="ir.ui.view">
        <field name="name">invoice.letterhead.design.form</field>
        <field name="model">invoice.letterhead.design</field>
        <field name="arch" type="xml">
            <form string="Invoice Design">
                <header>
                    <button name="action_preview" type="object" string="Preview with Sample Data"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="layout"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="letterhead_pdf" filename="letterhead_filename" widget="binary"/>
                            <field name="letterhead_filename" invisible="1"/>
                            <field name="top_offset"/>
                            <field name="bottom_offset"/>
                            <field name="color" placeholder="#2f6fa3"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        A multi-page PDF uses page 1 for the first invoice page and its last page for continuation pages.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_invoice_letterhead_design_list" model="ir.ui.view">
        <field name="name">invoice.letterhead.design.list</field>
        <field name="model">invoice.letterhead.design</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="layout"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_invoice_letterhead_design" model="ir.actions.act_window">
        <field name="name">Invoice Print Designs</field>
        <field name="res_model">invoice.letterhead.design</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_invoice_letterhead_design"
              name="Invoice Print Designs"
              parent="account.menu_finance_configuration"
              action="action_invoice_letterhead_design"
              sequence="95" groups="account.group_account_manager"/>
</odoo>
