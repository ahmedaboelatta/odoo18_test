<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_attachment_upload_wizard_form" model="ir.ui.view">
        <field name="name">pos.order.attachment.upload.wizard.form</field>
        <field name="model">pos.order.attachment.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload POS Attachment">
                <group>
                    <field name="order_id"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button
                        name="action_upload"
                        type="object"
                        string="Upload"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
