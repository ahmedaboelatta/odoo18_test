<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="hader_mobile_core.feature_attendance" model="hader.mobile.feature" forcecreate="1">
        <field name="name">Attendance</field>
        <field name="key">attendance</field>
        <field name="sequence">20</field>
        <field name="enabled" eval="True"/>
        <field name="minimum_app_version">0.2.0</field>
        <field name="requires_authentication" eval="True"/>
    </record>

    <record id="ir_cron_auto_checkout_unclosed_shifts" model="ir.cron">
        <field name="name">Hader Attendance: Auto Check-Out Unclosed Shifts</field>
        <field name="model_id" ref="model_hader_attendance_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_checkout_unclosed_shifts()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
