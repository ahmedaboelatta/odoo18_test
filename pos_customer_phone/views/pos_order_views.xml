<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_customer_phone.PosPhonePopup" owl="1">
        <div class="popup popup-text input pos-phone-popup">
            <div class="modal-header">
                <h4 class="modal-title"><t t-esc="props.title"/></h4>
            </div>
            <div class="modal-body">
                <input type="tel" 
                       class="form-control" 
                       t-model="state.phone" 
                       placeholder="05XXXXXXXX" 
                       t-ref="autofocus"/>
            </div>
            <div class="modal-footer">
                <div class="button confirm btn btn-primary" t-on-click="confirm">
                    <t t-esc="props.confirmText"/>
                </div>
                <div class="button cancel btn btn-secondary" t-on-click="cancel">
                    <t t-esc="props.cancelText"/>
                </div>
            </div>
        </div>
    </t>
</templates>