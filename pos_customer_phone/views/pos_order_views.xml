<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- MUST INCLUDE MODULE PREFIX "pos_customer_phone." -->
    <t t-name="pos_customer_phone.PosPhonePopup" owl="1">
        <div class="popup popup-text input pos-phone-popup">
            <div class="modal-header">
                <h4 class="modal-title">رقم جوال العميل / Customer Phone</h4>
            </div>
            <div class="modal-body">
                <input type="tel" class="form-control" t-model="state.phone" placeholder="05XXXXXXXX"/>
            </div>
            <div class="modal-footer">
                <button class="button confirm btn btn-primary" t-on-click="confirm">حفظ</button>
                <button class="button cancel btn btn-secondary" t-on-click="cancel">تخطي</button>
            </div>
        </div>
    </t>
</templates>