<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="point_of_sale.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]" position="inside">
            <div class="d-flex gap-2 mt-2">
                <input type="tel" 
                       class="flex-grow-1 border p-3 bg-view pe-5 border-end-0 rounded-start-2 send-receipt-phone-input" 
                       placeholder="05XXXXXXXX" 
                       t-model="state.customerPhone"/>
                <button class="btn btn-primary send-phone-button rounded-end-2 position-absolute end-0 top-0 bottom-0 px-4" 
                        t-on-click="onSavePhone">
                    <i class="fa fa-paper-plane" aria-hidden="true"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
