<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PointOfSale.ReceiptScreen" t-inherit="PointOfSale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]" position="inside">
            <button class="button add-phone btn btn-secondary w-100 py-2 mb-2" t-on-click="openPhonePopup">
                <i class="fa fa-phone me-1" /> Add Customer Phone
            </button>
        </xpath>
    </t>

    <t t-name="pos_customer_phone.PosPhonePopup" owl="1">
        <div class="popup popup-text input pos-phone-popup">
            <div class="modal-header">
                <h4 class="modal-title">Customer Phone / رقم الجوال</h4>
            </div>
            <div class="modal-body">
                <input type="tel" class="form-control" t-model="state.phone" placeholder="05XXXXXXXX"/>
            </div>
            <div class="modal-footer">
                <button class="button confirm btn btn-primary" t-on-click="confirm">Save</button>
                <button class="button cancel btn btn-secondary" t-on-click="cancel">Skip</button>
            </div>
        </div>
    </t>
</templates>
