<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="PointOfSale.ReceiptScreen" t-inherit="PointOfSale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]" position="inside">
            <button class="button add-phone btn btn-secondary w-100 py-2 mb-2" t-on-click="openPhonePopup">
                <i class="fa fa-phone me-1" /> Add Customer Phone
            </button>
        </xpath>
    </t>

    <t t-name="pos_customer_phone.PosPhonePopup" owl="1">
        <div class="popup pos-phone-popup">
            <h3 class="title">Customer Phone</h3>
            <input
                type="tel"
                class="text-center"
                t-model="state.phone"
                placeholder="05xxxxxxxx"
                autocomplete="tel"
                inputmode="numeric"
                pattern="[0-9]*"
                autofocus="true"/>
            <button class="button confirm" t-on-click="confirm">Save</button>
            <button class="button cancel" t-on-click="close">Cancel</button>
        </div>
    </t>
</templates>
