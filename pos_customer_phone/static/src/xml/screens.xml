<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="point_of_sale.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]" position="inside">
            <div class="d-flex gap-2 mt-2">
                <input type="tel"
                       class="form-control flex-grow-1"
                       placeholder="رقم جوال العميل (05XXXXXXXX)"
                       t-model="state.customerPhone"
                       inputmode="numeric"
                       pattern="[0-9]*"/>
                <button class="btn btn-primary"
                        t-on-click="saveCustomerPhone">
                    <i class="fa fa-save"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
