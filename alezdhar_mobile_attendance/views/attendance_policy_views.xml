<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_policy_list" model="ir.ui.view"><field name="name">alezdhar.attendance.policy.list</field><field name="model">alezdhar.attendance.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="shift_start_hour" widget="float_time"/><field name="shift_end_hour" widget="float_time"/><field name="attendance_mode"/><field name="require_geofence"/><field name="allow_mobile_punch"/></list></field></record>
    <record id="view_attendance_policy_form" model="ir.ui.view"><field name="name">alezdhar.attendance.policy.form</field><field name="model">alezdhar.attendance.policy</field><field name="arch" type="xml"><form><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><group><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="attendance_mode"/><field name="allow_mobile_punch"/><field name="require_geofence" invisible="attendance_mode in ['remote', 'field']"/><field name="maximum_accuracy_m"/><field name="biometric_provider"/></group><group string="Shift"><field name="timezone"/><field name="shift_start_hour" widget="float_time"/><field name="shift_end_hour" widget="float_time"/><field name="late_grace_minutes"/><field name="early_leave_grace_minutes"/></group></group></sheet><chatter/></form></field></record>
    <record id="view_attendance_policy_search" model="ir.ui.view"><field name="name">alezdhar.attendance.policy.search</field><field name="model">alezdhar.attendance.policy</field><field name="arch" type="xml"><search><field name="name"/><field name="attendance_mode"/><filter name="mobile" string="Mobile Punch Allowed" domain="[('allow_mobile_punch','=',True)]"/><filter name="geofence" string="Requires Geofence" domain="[('require_geofence','=',True)]"/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><group expand="0" string="Group By"><filter name="group_mode" string="Attendance Mode" context="{'group_by':'attendance_mode'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
    <record id="action_attendance_policy" model="ir.actions.act_window"><field name="name">Attendance Policies</field><field name="res_model">alezdhar.attendance.policy</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_attendance_policy_search"/></record>
    <record id="view_attendance_assignment_list" model="ir.ui.view"><field name="name">alezdhar.employee.attendance.assignment.list</field><field name="model">alezdhar.employee.attendance.assignment</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="policy_id"/><field name="location_ids" widget="many2many_tags"/><field name="date_from"/><field name="date_to"/></list></field></record>
    <record id="view_attendance_assignment_form" model="ir.ui.view"><field name="name">alezdhar.employee.attendance.assignment.form</field><field name="model">alezdhar.employee.attendance.assignment</field><field name="arch" type="xml"><form><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><group><field name="employee_id"/><field name="policy_id"/><field name="location_ids" widget="many2many_tags"/><field name="date_from"/><field name="date_to"/></group></sheet><chatter/></form></field></record>
    <record id="view_attendance_assignment_search" model="ir.ui.view"><field name="name">alezdhar.employee.attendance.assignment.search</field><field name="model">alezdhar.employee.attendance.assignment</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="policy_id"/><field name="location_ids"/><filter name="active_now" string="Active Assignments" domain="[('active','=',True)]"/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><group expand="0" string="Group By"><filter name="group_policy" string="Policy" context="{'group_by':'policy_id'}"/><filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/></group></search></field></record>
    <record id="action_attendance_assignment" model="ir.actions.act_window"><field name="name">Employee Assignments</field><field name="res_model">alezdhar.employee.attendance.assignment</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_attendance_assignment_search"/></record>
</odoo>
