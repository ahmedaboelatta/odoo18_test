<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_work_location_list" model="ir.ui.view"><field name="name">alezdhar.work.location.list</field><field name="model">alezdhar.work.location</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="radius_m"/><field name="maximum_accuracy_m"/></list></field></record>
    <record id="view_work_location_form" model="ir.ui.view"><field name="name">alezdhar.work.location.form</field><field name="model">alezdhar.work.location</field><field name="arch" type="xml"><form><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Geofence"><field name="latitude"/><field name="longitude"/><field name="radius_m"/><field name="maximum_accuracy_m"/></group></sheet><chatter/></form></field></record>
    <record id="view_work_location_search" model="ir.ui.view"><field name="name">alezdhar.work.location.search</field><field name="model">alezdhar.work.location</field><field name="arch" type="xml"><search><field name="name"/><field name="company_id"/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><group expand="0" string="Group By"><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
    <record id="action_work_location" model="ir.actions.act_window"><field name="name">Work Locations</field><field name="res_model">alezdhar.work.location</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_work_location_search"/></record>
</odoo>
