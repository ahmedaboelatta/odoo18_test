<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_event_list" model="ir.ui.view"><field name="name">alezdhar.attendance.event.list</field><field name="model">alezdhar.attendance.event</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="review_state == 'rejected'" decoration-warning="review_state == 'review'"><field name="server_time"/><field name="employee_id"/><field name="operation"/><field name="verification_method"/><field name="face_match_score" optional="show"/><field name="review_state" widget="badge" decoration-success="review_state == 'accepted'" decoration-danger="review_state == 'rejected'" decoration-warning="review_state == 'review'"/><field name="rejection_reason" optional="show"/><field name="attendance_check_in" optional="show"/><field name="attendance_check_out" optional="show"/><field name="worked_hours" widget="float_time" optional="hide"/><field name="punctuality_status" optional="show"/><field name="variance_minutes" optional="show"/><field name="location_id" optional="show"/></list></field></record>
    <record id="view_attendance_event_search" model="ir.ui.view"><field name="name">alezdhar.attendance.event.search</field><field name="model">alezdhar.attendance.event</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="operation"/><field name="rejection_reason"/><filter string="Rejected (المرفوضة)" name="filter_rejected" domain="[('review_state', '=', 'rejected')]"/><filter string="Accepted (المقبولة)" name="filter_accepted" domain="[('review_state', '=', 'accepted')]"/><group expand="0" string="Group By"><filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/><filter string="Review State" name="group_review_state" context="{'group_by': 'review_state'}"/><filter string="Day" name="group_day" context="{'group_by': 'server_time:day'}"/></group></search></field></record>
    <record id="view_attendance_event_form" model="ir.ui.view"><field name="name">alezdhar.attendance.event.form</field><field name="model">alezdhar.attendance.event</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><group><field name="server_time"/><field name="employee_id"/><field name="operation"/><field name="review_state" widget="badge" decoration-success="review_state == 'accepted'" decoration-danger="review_state == 'rejected'"/><field name="rejection_reason" invisible="not rejection_reason"/><field name="attendance_id"/><field name="attendance_check_in"/><field name="attendance_check_out"/><field name="worked_hours" widget="float_time"/><field name="punctuality_status"/><field name="variance_minutes"/></group><group><field name="identity_id"/><field name="device_id"/><field name="request_id"/><field name="policy_id"/><field name="verification_method"/><field name="liveness_verified" invisible="verification_method != 'face_biometric'"/><field name="face_match_score" invisible="verification_method != 'face_biometric'"/><field name="selfie_image" widget="image" class="oe_avatar" invisible="verification_method != 'face_biometric'" groups="alezdhar_mobile_core.group_mobile_auditor"/></group></group><group string="Location audit"><field name="location_id"/><field name="latitude"/><field name="longitude"/><field name="accuracy_m"/><field name="distance_m"/><field name="geofence_outcome"/><field name="attendance_mode"/></group></sheet></form></field></record>
    <record id="action_attendance_event" model="ir.actions.act_window"><field name="name">Attendance Events</field><field name="res_model">alezdhar.attendance.event</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_attendance_event_search"/></record>
    <record id="view_attendance_report_list" model="ir.ui.view"><field name="name">alezdhar.attendance.report.list</field><field name="model">alezdhar.attendance.report</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="employee_id"/><field name="check_in"/><field name="check_out"/><field name="worked_hours" widget="float_time"/><field name="overtime_hours" widget="float_time"/><field name="late_minutes"/><field name="early_leave_minutes"/><field name="attendance_mode"/><field name="location_id"/></list></field></record>
    <record id="view_attendance_report_search" model="ir.ui.view"><field name="name">alezdhar.attendance.report.search</field><field name="model">alezdhar.attendance.report</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="check_in"/><field name="attendance_mode"/><filter string="Open" name="open" domain="[('check_out','=',False)]"/><group expand="0" string="Group By"><filter string="Employee" name="employee" context="{'group_by':'employee_id'}"/><filter string="Day" name="day" context="{'group_by':'check_in:day'}"/></group></search></field></record>
    <record id="view_attendance_report_form" model="ir.ui.view"><field name="name">alezdhar.attendance.report.form</field><field name="model">alezdhar.attendance.report</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><group><field name="employee_id"/><field name="check_in"/><field name="check_out"/><field name="attendance_mode"/></group><group><field name="worked_hours" widget="float_time"/><field name="expected_hours" widget="float_time"/><field name="overtime_hours" widget="float_time"/><field name="late_minutes"/><field name="early_leave_minutes"/></group></group><notebook><page string="Attendance Logs"><field name="event_ids" nolabel="1" readonly="1"><list create="0" edit="0" delete="0"><field name="server_time"/><field name="operation"/><field name="verification_method"/><field name="location_id"/><field name="latitude"/><field name="longitude"/><field name="accuracy_m"/><field name="distance_m"/><field name="device_id"/><field name="review_state"/></list></field></page></notebook></sheet></form></field></record>
    <record id="action_attendance_report" model="ir.actions.act_window"><field name="name">Attendance Report</field><field name="res_model">alezdhar.attendance.report</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_attendance_report_search"/></record>
</odoo>
