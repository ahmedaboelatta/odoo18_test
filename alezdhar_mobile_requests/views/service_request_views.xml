<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_service_list" model="ir.ui.view"><field name="name">alezdhar.mobile.service.list</field><field name="model">alezdhar.mobile.service</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="service_type"/><field name="state" widget="badge"/><field name="responsible_user_ids" widget="many2many_tags"/><field name="icon"/><field name="allow_attachment"/></list></field></record>
    <record id="view_mobile_service_search" model="ir.ui.view"><field name="name">alezdhar.mobile.service.search</field><field name="model">alezdhar.mobile.service</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="responsible_user_ids"/><filter name="published" string="Published" domain="[('state','=','published')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="complaints" string="Complaints" domain="[('service_type','=','complaint')]"/><separator/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><group expand="0" string="Group By"><filter name="group_type" string="Type" context="{'group_by':'service_type'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
    <record id="view_mobile_service_form" model="ir.ui.view"><field name="name">alezdhar.mobile.service.form</field><field name="model">alezdhar.mobile.service</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state == 'published'"/><button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,published"/></header><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="description"/><field name="icon"/><field name="company_id" groups="base.group_multi_company"/><field name="allow_attachment"/></group><group><field name="service_type"/><field name="responsible_user_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="sequence"/></group></group><notebook><page string="Request Form"><div class="alert alert-info" role="alert">Add a field, save it, then open its row to configure radio-button or dropdown options.</div><field name="field_ids" mode="list,form"><list><field name="sequence" widget="handle"/><field name="label"/><field name="key"/><field name="field_type"/><field name="required"/></list><form string="Request Field"><sheet><group><field name="label"/><field name="key"/><field name="field_type"/><field name="required"/></group><group string="Available Options" invisible="field_type not in ['radio','select']"><field name="option_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="label"/><field name="value"/></list></field></group></sheet></form></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_mobile_service_request_list" model="ir.ui.view"><field name="name">alezdhar.mobile.service.request.list</field><field name="model">alezdhar.mobile.service.request</field><field name="arch" type="xml"><list create="0" decoration-muted="not active"><field name="name"/><field name="employee_id"/><field name="service_id"/><field name="state" widget="badge"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="assigned_user_id" optional="hide"/><field name="create_date"/></list></field></record>
    <record id="view_mobile_service_request_search" model="ir.ui.view"><field name="name">alezdhar.mobile.service.request.search</field><field name="model">alezdhar.mobile.service.request</field><field name="arch" type="xml"><search><field name="name"/><field name="employee_id"/><field name="service_id"/><field name="assigned_user_ids"/><filter name="waiting" string="Under Review" domain="[('state','in',['submitted','in_progress'])]"/><filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/><filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/><filter name="done" string="Completed" domain="[('state','=','done')]"/><filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/><separator/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><group expand="0" string="Group By"><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_service" string="Service" context="{'group_by':'service_id'}"/><filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/><filter name="group_assigned" string="Primary Assigned User" context="{'group_by':'assigned_user_id'}"/></group></search></field></record>
    <record id="view_mobile_service_request_form" model="ir.ui.view"><field name="name">alezdhar.mobile.service.request.form</field><field name="model">alezdhar.mobile.service.request</field><field name="arch" type="xml"><form create="0"><header><button name="action_start" type="object" string="Start" invisible="state != 'submitted'" class="btn-primary"/><button name="action_done" type="object" string="Complete" invisible="state not in ['submitted','in_progress']" class="btn-primary"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['submitted','in_progress']"/><field name="state" widget="statusbar" statusbar_visible="submitted,in_progress,done,rejected"/></header><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><group><group><field name="name"/><field name="employee_id"/><field name="service_id"/></group><group><field name="assigned_user_ids" widget="many2many_tags"/><field name="assigned_user_id"/><field name="create_date"/></group></group><group><field name="description"/><field name="answers_json" widget="json"/><field name="resolution"/></group></sheet><chatter open_attachments="True"/></form></field></record>
    <record id="action_mobile_services" model="ir.actions.act_window"><field name="name">Employee Services</field><field name="res_model">alezdhar.mobile.service</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_mobile_service_search"/></record>
    <record id="action_mobile_service_requests" model="ir.actions.act_window"><field name="name">Service Requests</field><field name="res_model">alezdhar.mobile.service.request</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_mobile_service_request_search"/></record>
    <record id="action_mobile_complaints" model="ir.actions.act_window"><field name="name">Employee Complaints</field><field name="res_model">alezdhar.mobile.service.request</field><field name="view_mode">list,form</field><field name="domain">[('service_id.service_type','=','complaint')]</field><field name="context">{'search_default_waiting': 1}</field><field name="search_view_id" ref="view_mobile_service_request_search"/></record>
    <menuitem id="menu_mobile_requests" name="Requests" parent="alezdhar_mobile_core.menu_mobile_root" sequence="25" groups="alezdhar_mobile_core.group_mobile_auditor"/>
    <menuitem id="menu_mobile_service_requests" name="Service Requests" parent="menu_mobile_requests" action="action_mobile_service_requests" sequence="10"/>
    <menuitem id="menu_mobile_complaints" name="Employee Complaints" parent="menu_mobile_requests" action="action_mobile_complaints" sequence="20"/>
    <menuitem id="menu_mobile_services_config" name="Employee Services" parent="alezdhar_mobile_core.menu_mobile_configuration" action="action_mobile_services" sequence="30" groups="alezdhar_mobile_core.group_mobile_admin"/>
</odoo>
