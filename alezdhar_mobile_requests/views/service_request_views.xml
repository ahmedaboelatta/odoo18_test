<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_service_list" model="ir.ui.view"><field name="name">alezdhar.mobile.service.list</field><field name="model">alezdhar.mobile.service</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="icon"/><field name="allow_attachment"/><field name="active"/></list></field></record>
    <record id="view_mobile_service_form" model="ir.ui.view"><field name="name">alezdhar.mobile.service.form</field><field name="model">alezdhar.mobile.service</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="description"/><field name="icon"/><field name="company_id" groups="base.group_multi_company"/><field name="allow_attachment"/><field name="active"/></group></sheet></form></field></record>
    <record id="view_mobile_service_request_list" model="ir.ui.view"><field name="name">alezdhar.mobile.service.request.list</field><field name="model">alezdhar.mobile.service.request</field><field name="arch" type="xml"><list create="0"><field name="name"/><field name="employee_id"/><field name="service_id"/><field name="state"/><field name="assigned_user_id"/><field name="create_date"/></list></field></record>
    <record id="view_mobile_service_request_form" model="ir.ui.view"><field name="name">alezdhar.mobile.service.request.form</field><field name="model">alezdhar.mobile.service.request</field><field name="arch" type="xml"><form create="0"><header><button name="action_start" type="object" string="Start" invisible="state != 'submitted'" class="btn-primary"/><button name="action_done" type="object" string="Complete" invisible="state not in ['submitted','in_progress']" class="btn-primary"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['submitted','in_progress']"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="employee_id"/><field name="service_id"/></group><group><field name="assigned_user_id"/><field name="create_date"/></group></group><group><field name="description"/><field name="resolution"/></group></sheet><chatter/></form></field></record>
    <record id="action_mobile_services" model="ir.actions.act_window"><field name="name">Employee Services</field><field name="res_model">alezdhar.mobile.service</field><field name="view_mode">list,form</field></record>
    <record id="action_mobile_service_requests" model="ir.actions.act_window"><field name="name">Service Requests</field><field name="res_model">alezdhar.mobile.service.request</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_mobile_requests" name="Requests" parent="alezdhar_mobile_core.menu_mobile_root" sequence="25" groups="alezdhar_mobile_core.group_mobile_auditor"/>
    <menuitem id="menu_mobile_service_requests" name="Service Requests" parent="menu_mobile_requests" action="action_mobile_service_requests" sequence="10"/>
    <menuitem id="menu_mobile_services_config" name="Employee Services" parent="alezdhar_mobile_core.menu_mobile_configuration" action="action_mobile_services" sequence="30" groups="alezdhar_mobile_core.group_mobile_admin"/>
</odoo>
