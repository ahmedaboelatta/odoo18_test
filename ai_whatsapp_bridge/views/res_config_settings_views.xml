<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_whatsapp_bridge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.whatsapp.bridge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI WhatsApp Bridge" name="ai_whatsapp_bridge" groups="bird_connector.group_bird_administrator,base.group_system">
                    <block title="General">
                        <setting string="Enable AI WhatsApp Bridge" help="Master switch for all brand profiles.">
                            <field name="ai_whatsapp_bridge_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
