<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_notification_campaign_list" model="ir.ui.view">
        <field name="name">hader.mobile.notification.campaign.list</field>
        <field name="model">hader.mobile.notification.campaign</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'sent'" decoration-info="state == 'scheduled'">
                <field name="name"/>
                <field name="audience"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-info="state == 'scheduled'" decoration-muted="state == 'draft'"/>
                <field name="recipient_count"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>
    <record id="view_notification_campaign_form" model="ir.ui.view">
        <field name="name">hader.mobile.notification.campaign.form</field>
        <field name="model">hader.mobile.notification.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" string="إرسال الإشعار / Send" type="object" class="btn-success" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,sent"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="تم الإرسال / Sent" bg_color="text-bg-success" invisible="state != 'sent'"/>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="audience" readonly="state != 'draft'"/>
                            <field name="employee_ids" widget="many2many_tags" invisible="audience != 'selected'" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="scheduled_at" readonly="state != 'draft'"/>
                            <field name="recipient_count" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="title" invisible="1"/>
                    <field name="body" invisible="1"/>
                    <group string="محتوى الإشعار / Notification Content">
                        <group string="العربية">
                            <field name="title_ar" required="1" readonly="state != 'draft'" placeholder="عنوان الإشعار بالعربية"/>
                            <field name="body_ar" required="1" readonly="state != 'draft'" placeholder="نص الإشعار بالعربية"/>
                        </group>
                        <group string="English">
                            <field name="title_en" required="1" readonly="state != 'draft'" placeholder="Notification title in English"/>
                            <field name="body_en" required="1" readonly="state != 'draft'" placeholder="Notification text in English"/>
                        </group>
                    </group>
                    <group>
                        <field name="image_url" readonly="state != 'draft'" placeholder="https://example.com/image.png"/>
                    </group>
                    <notebook>
                        <page string="معاينة بالعربية / Arabic Preview">
                            <field name="preview_ar" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="معاينة بالإنجليزية / English Preview">
                            <field name="preview_en" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="سجل إرسال الإشعارات / Push Delivery Log">
                            <div class="alert alert-info" role="alert">
                                <strong>ملاحظة:</strong> حالة <strong>تم الإرسال (Sent)</strong> تعني وصول الإشعار لصندوق الإشعارات داخل التطبيق، وحالة <strong>Accepted by Firebase</strong> تعني استلام خوادم Firebase للإشعار بنجاح لإرساله إلى هاتف الموظف.
                            </div>
                            <field name="delivery_ids" readonly="1" nolabel="1">
                                <list create="0" edit="0" delete="0" decoration-danger="state in ('failed', 'unregistered')" decoration-success="state == 'sent'">
                                    <field name="create_date"/>
                                    <field name="employee_id"/>
                                    <field name="device_id"/>
                                    <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-danger="state in ('failed', 'unregistered')" decoration-warning="state == 'pending'"/>
                                    <field name="sent_at"/>
                                    <field name="firebase_message_id"/>
                                    <field name="error_code"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_notification_inbox_list" model="ir.ui.view">
        <field name="name">hader.mobile.notification.inbox.list</field>
        <field name="model">hader.mobile.notification.inbox</field>
        <field name="arch" type="xml"><list create="0" delete="0"><field name="employee_id"/><field name="title"/><field name="category"/><field name="is_read"/><field name="create_date"/></list></field>
    </record>
    <record id="view_push_delivery_list" model="ir.ui.view">
        <field name="name">hader.mobile.push.delivery.list</field>
        <field name="model">hader.mobile.push.delivery</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state in ('failed', 'unregistered')" decoration-success="state == 'sent'">
                <field name="create_date"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-danger="state in ('failed', 'unregistered')" decoration-warning="state == 'pending'"/>
                <field name="firebase_message_id"/>
                <field name="error_code"/>
                <field name="error_message"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>
    <record id="view_notification_campaign_search" model="ir.ui.view">
        <field name="name">hader.mobile.notification.campaign.search</field>
        <field name="model">hader.mobile.notification.campaign</field>
        <field name="arch" type="xml">
            <search string="Campaigns (حملات الإشعارات الجماعية)">
                <field name="name"/>
                <field name="title_ar"/>
                <field name="title_en"/>
                <field name="company_id"/>
                <filter name="filter_sent" string="تم الإرسال / Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_draft" string="مسودة / Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_scheduled" string="مجدول / Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <separator/>
                <filter name="group_state" string="الحالة / Status" context="{'group_by': 'state'}"/>
                <filter name="group_audience" string="الجمهور المستهدف / Audience" context="{'group_by': 'audience'}"/>
                <filter name="group_company" string="الشركة / Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_date" string="تاريخ الإرسال / Sent Date" context="{'group_by': 'sent_at:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_notification_inbox_search" model="ir.ui.view">
        <field name="name">hader.mobile.notification.inbox.search</field>
        <field name="model">hader.mobile.notification.inbox</field>
        <field name="arch" type="xml">
            <search string="Notification Delivery (سجل صندوق الإشعارات)">
                <field name="employee_id"/>
                <field name="title"/>
                <field name="category"/>
                <filter name="filter_unread" string="غير مقروء / Unread" domain="[('is_read', '=', False)]"/>
                <filter name="filter_read" string="مقروء / Read" domain="[('is_read', '=', True)]"/>
                <separator/>
                <filter name="group_employee" string="الموظف / Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_category" string="التصنيف / Category" context="{'group_by': 'category'}"/>
                <filter name="group_read" string="حالة القراءة / Read Status" context="{'group_by': 'is_read'}"/>
                <filter name="group_date" string="التاريخ / Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_push_delivery_search" model="ir.ui.view">
        <field name="name">hader.mobile.push.delivery.search</field>
        <field name="model">hader.mobile.push.delivery</field>
        <field name="arch" type="xml">
            <search string="Push Delivery Log (سجل إرسال Firebase)">
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="firebase_message_id"/>
                <field name="error_code"/>
                <filter name="filter_sent" string="تم الإرسال لـ Firebase / Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_failed" string="فشل الإرسال / Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_pending" string="معلق / Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_unregistered" string="غير مسجل / Unregistered Device" domain="[('state', '=', 'unregistered')]"/>
                <separator/>
                <filter name="group_state" string="حالة الإرسال / Delivery Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="الموظف / Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_error" string="كود الخطأ / Error Code" context="{'group_by': 'error_code'}"/>
                <filter name="group_date" string="التاريخ / Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_notification_campaign" model="ir.actions.act_window"><field name="name">Notification Campaigns (حملات الإشعارات الجماعية)</field><field name="res_model">hader.mobile.notification.campaign</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_notification_campaign_search"/></record>
    <record id="action_notification_inbox" model="ir.actions.act_window"><field name="name">Notification Delivery (سجل صندوق الإشعارات)</field><field name="res_model">hader.mobile.notification.inbox</field><field name="view_mode">list</field><field name="search_view_id" ref="view_notification_inbox_search"/></record>
    <record id="action_push_delivery" model="ir.actions.act_window"><field name="name">Push Delivery Log (سجل إرسال Firebase)</field><field name="res_model">hader.mobile.push.delivery</field><field name="view_mode">list</field><field name="search_view_id" ref="view_push_delivery_search"/></record>
    <menuitem id="menu_mobile_notifications" name="Notifications (الإشعارات)" parent="hader_mobile_core.menu_mobile_root" sequence="30" groups="hader_mobile_core.group_mobile_auditor"/>
    <menuitem id="menu_notification_campaign" name="Campaigns (حملات الإشعارات الجماعية)" parent="menu_mobile_notifications" action="action_notification_campaign" sequence="10" groups="hader_mobile_core.group_mobile_admin"/>
    <menuitem id="menu_notification_inbox" name="Delivery Log (سجل صندوق الإشعارات)" parent="menu_mobile_notifications" action="action_notification_inbox" sequence="20"/>
    <menuitem id="menu_push_delivery" name="Push Delivery Log (سجل إرسال Firebase)" parent="menu_mobile_notifications" action="action_push_delivery" sequence="30"/>
</odoo>
