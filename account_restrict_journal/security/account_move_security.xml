<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_rule_users" model="ir.rule">
        <field name="name">Allowed journals only</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="domain_force">[('id', 'in', user.allowed_journal_ids.ids)] if user.allowed_journal_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_payment_rule_users" model="ir.rule">
        <field name="name">Payments in allowed journals only</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="domain_force">[('journal_id', 'in', user.allowed_journal_ids.ids)] if user.allowed_journal_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="account_move_rule_users" model="ir.rule">
        <field name="name">Journal entries in allowed journals only</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('journal_id', 'in', user.allowed_journal_ids.ids)] if user.allowed_journal_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <!-- Keep obsolete rules disabled when upgrading from 18.0.1.0.0. -->
    <record id="account_restricted_journal_rule_users" model="ir.rule">
        <field name="name">Obsolete restricted-journal rule</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="domain_force">[(1, '=', 0)]</field>
        <field name="active" eval="False"/>
    </record>
    <record id="account_payments_restricted_rule_users" model="ir.rule">
        <field name="name">Obsolete restricted-payment rule</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="domain_force">[(1, '=', 0)]</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
