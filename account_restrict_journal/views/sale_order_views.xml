<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_allowed_journals" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.allowed.journals</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="groups">account_restrict_journal.account_restrict_journal_group_admin,account.group_account_invoice</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>

