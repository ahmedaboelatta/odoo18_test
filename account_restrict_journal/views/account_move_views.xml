<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.allowed.journals</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='invoice_date'])[1]" position="after">
                <field name="journal_restriction_enabled" invisible="1"/>
                <field name="journal_id"
                       string="Journal"
                       readonly="1"
                       invisible="not journal_restriction_enabled"
                       groups="base.group_user"
                       options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
