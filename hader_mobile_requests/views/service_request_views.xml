<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_service_list" model="ir.ui.view"><field name="name">hader.mobile.service.list</field><field name="model">hader.mobile.service</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="service_type"/><field name="state" widget="badge"/><field name="responsible_user_ids" widget="many2many_tags"/><field name="icon"/><field name="allow_attachment"/></list></field></record>
    <record id="view_mobile_service_search" model="ir.ui.view"><field name="name">hader.mobile.service.search</field><field name="model">hader.mobile.service</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="responsible_user_ids"/><filter name="published" string="Published" domain="[('state','=','published')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="complaints" string="Complaints" domain="[('service_type','=','complaint')]"/><separator/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><filter name="group_type" string="Type" context="{'group_by':'service_type'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></search></field></record>
    <record id="view_mobile_service_form" model="ir.ui.view"><field name="name">hader.mobile.service.form</field><field name="model">hader.mobile.service</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state == 'published'"/><button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,published"/></header><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="description"/><field name="icon"/><field name="company_id" groups="base.group_multi_company"/><field name="allow_attachment"/></group><group><field name="service_type"/><field name="responsible_user_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="sequence"/></group></group><notebook><page string="Request Form"><div class="alert alert-info" role="alert">Add a field, save it, then open its row to configure radio-button or dropdown options.</div><field name="field_ids" mode="list,form"><list><field name="sequence" widget="handle"/><field name="label"/><field name="key"/><field name="field_type"/><field name="required"/></list><form string="Request Field"><sheet><group><field name="label"/><field name="key"/><field name="field_type"/><field name="required"/></group><group string="Available Options" invisible="field_type not in ['radio','select']"><field name="option_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="label"/><field name="value"/></list></field></group></sheet></form></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_mobile_service_request_list" model="ir.ui.view"><field name="name">hader.mobile.service.request.list</field><field name="model">hader.mobile.service.request</field><field name="arch" type="xml"><list create="0" decoration-muted="not active"><field name="name"/><field name="employee_id"/><field name="service_id"/><field name="state" widget="badge"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="assigned_user_id" optional="hide"/><field name="create_date"/></list></field></record>
    <record id="view_mobile_service_request_search" model="ir.ui.view"><field name="name">hader.mobile.service.request.search</field><field name="model">hader.mobile.service.request</field><field name="arch" type="xml"><search><field name="name"/><field name="employee_id"/><field name="service_id"/><field name="assigned_user_ids"/><filter name="waiting" string="Under Review" domain="[('state','in',['submitted','in_progress'])]"/><filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/><filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/><filter name="done" string="Completed" domain="[('state','=','done')]"/><filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/><separator/><filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_service" string="Service" context="{'group_by':'service_id'}"/><filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/><filter name="group_assigned" string="Primary Assigned User" context="{'group_by':'assigned_user_id'}"/></search></field></record>
    <record id="view_mobile_service_request_form" model="ir.ui.view"><field name="name">hader.mobile.service.request.form</field><field name="model">hader.mobile.service.request</field><field name="arch" type="xml"><form create="0"><header><button name="action_start" type="object" string="Start" invisible="state != 'submitted'" class="btn-primary"/><button name="action_done" type="object" string="Complete" invisible="state not in ['submitted','in_progress']" class="btn-primary"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['submitted','in_progress']"/><field name="state" widget="statusbar" statusbar_visible="submitted,in_progress,done,rejected"/></header><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><group><group><field name="name"/><field name="employee_id"/><field name="service_id"/></group><group><field name="assigned_user_ids" widget="many2many_tags"/><field name="assigned_user_id"/><field name="create_date"/></group></group><group><field name="description"/><field name="answers_json" widget="json"/><field name="resolution"/></group></sheet><chatter open_attachments="True"/></form></field></record>

    <!-- Employee Expenses Views -->
    <record id="view_mobile_expense_category_list" model="ir.ui.view">
        <field name="name">hader.mobile.expense.category.list</field>
        <field name="model">hader.mobile.expense.category</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_expense_list" model="ir.ui.view">
        <field name="name">hader.mobile.expense.list</field>
        <field name="model">hader.mobile.expense</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="not active" decoration-info="state == 'manager_approved'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id" optional="show"/>
                <field name="category_id"/>
                <field name="title"/>
                <field name="expense_date"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="attachment_count" string="المرفقات / Attachments"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'" decoration-info="state == 'manager_approved'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_expense_search" model="ir.ui.view">
        <field name="name">hader.mobile.expense.search</field>
        <field name="model">hader.mobile.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="category_id"/>
                <field name="title"/>
                <filter name="manager_approved" string="معتمد من المدير (جاهز للصرف) / Manager Approved" domain="[('state','=','manager_approved')]"/>
                <filter name="submitted" string="بانتظار موافقة المدير / Waiting Manager" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="معتمد نهائياً / Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="مرفوض / Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/>
                
                    <filter name="group_state" string="الحالة / Status" context="{'group_by':'state'}"/>
                    <filter name="group_employee" string="الموظف / Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_category" string="التصنيف / Category" context="{'group_by':'category_id'}"/>
                    <filter name="group_date" string="تاريخ المصروف / Expense Date" context="{'group_by':'expense_date'}"/>
                
            </search>
        </field>
    </record>

    <record id="view_mobile_expense_form" model="ir.ui.view">
        <field name="name">hader.mobile.expense.form</field>
        <field name="model">hader.mobile.expense</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_manager_approve" type="object" string="اعتماد كمدير / Manager Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object" string="اعتماد نهائي وصرف / Final Approve" class="btn-success" invisible="state in ['approved','rejected']"/>
                    <button name="action_reject" type="object" string="رفض / Reject" class="btn-danger" invisible="state in ['approved','rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,manager_approved,approved,rejected"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <widget name="web_ribbon" title="معتمد نهائياً / Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="مرفوض / Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="title" readonly="state in ['approved','rejected']"/></h3>
                    </div>
                    <group>
                        <group string="بيانات الموظف والمصروف / Expense Info">
                            <field name="employee_id" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="category_id" readonly="state in ['approved','rejected']"/>
                            <field name="expense_date" readonly="state in ['approved','rejected']"/>
                            <field name="amount" readonly="state in ['approved','rejected']"/>
                        </group>
                        <group string="مراجعة المدير والإدارة / Approvals">
                            <field name="manager_reviewed_by_id" readonly="1"/>
                            <field name="manager_reviewed_at" readonly="1"/>
                            <field name="manager_review_note" readonly="1"/>
                            <field name="admin_note" placeholder="اكتب ملاحظة الصرف أو سبب الرفض هنا..."/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="تفاصيل وملاحظات الموظف / Employee Notes">
                        <field name="notes" nolabel="1" readonly="state in ['approved','rejected']"/>
                    </group>
                    <group string="المرفقات والفواتير المرفوعة من التطبيق / Attached Receipts &amp; Invoices">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter open_attachments="True"/>
            </form>
        </field>
    </record>

    <!-- Employee Custody (عهد الموظفين الشخصية) Views -->
    <record id="view_mobile_custody_list" model="ir.ui.view">
        <field name="name">hader.mobile.custody.list</field>
        <field name="model">hader.mobile.custody</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active" decoration-info="state in ['manager_approved','return_requested']" decoration-success="state == 'assigned'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id" optional="show"/>
                <field name="item_type"/>
                <field name="title"/>
                <field name="serial_number" optional="show"/>
                <field name="request_date"/>
                <field name="assigned_date" optional="show"/>
                <field name="return_date" optional="hide"/>
                <field name="attachment_count" string="المرفقات / Attachments"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'" decoration-info="state in ['manager_approved','return_requested']" decoration-success="state == 'assigned'" decoration-muted="state == 'returned'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_custody_search" model="ir.ui.view">
        <field name="name">hader.mobile.custody.search</field>
        <field name="model">hader.mobile.custody</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="title"/>
                <field name="serial_number"/>
                <filter name="active_custody" string="في عهدة الموظف حالياً / Active in Custody" domain="[('state','=','assigned')]"/>
                <filter name="waiting_handover" string="بانتظار التسليم أو المراجعة / Pending" domain="[('state','in',['submitted','manager_approved','return_requested'])]"/>
                <filter name="returned" string="مُخلى / تم الإرجاع / Returned" domain="[('state','=','returned')]"/>
                
                    <filter name="group_employee" string="الموظف / Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_type" string="نوع العهدة / Asset Type" context="{'group_by':'item_type'}"/>
                    <filter name="group_state" string="الحالة / Status" context="{'group_by':'state'}"/>
                
            </search>
        </field>
    </record>

    <record id="view_mobile_custody_form" model="ir.ui.view">
        <field name="name">hader.mobile.custody.form</field>
        <field name="model">hader.mobile.custody</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_manager_approve" type="object" string="اعتماد كمدير / Manager Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_assign" type="object" string="تسليم العهدة للموظف / Handover &amp; Assign" class="btn-success" invisible="state not in ['submitted','manager_approved']"/>
                    <button name="action_mark_returned" type="object" string="تأكيد استلام وإخلاء العهدة / Confirm Return" class="btn-primary" invisible="state not in ['assigned','return_requested']"/>
                    <button name="action_reject" type="object" string="رفض / Reject" class="btn-danger" invisible="state in ['assigned','returned','rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,manager_approved,assigned,returned"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="في عهدة الموظف / Active" bg_color="text-bg-success" invisible="state != 'assigned'"/>
                    <widget name="web_ribbon" title="تم إخلاء الطرف / Returned" bg_color="text-bg-secondary" invisible="state != 'returned'"/>
                    <widget name="web_ribbon" title="مرفوض / Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="title" placeholder="مثال: لابتوب MacBook Pro / جوال iPhone 15 / شريحة موبايلي"/></h3>
                    </div>
                    <group>
                        <group string="بيانات العهدة والموظف / Custody Info">
                            <field name="employee_id"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="item_type"/>
                            <field name="serial_number" placeholder="S/N أو IMEI أو رقم الشريحة أو اللوحة"/>
                            <field name="request_date"/>
                            <field name="assigned_date"/>
                            <field name="return_date"/>
                        </group>
                        <group string="المراجعة والإدارة / Approvals &amp; Clearance">
                            <field name="manager_reviewed_by_id" readonly="1"/>
                            <field name="manager_reviewed_at" readonly="1"/>
                            <field name="manager_review_note" readonly="1"/>
                            <field name="admin_note" placeholder="ملاحظة التسليم أو إخلاء الطرف أو سبب الرفض..."/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="المواصفات وحالة العهدة والملاحظات / Notes &amp; Specifications">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="صور ومستندات العهدة / Attached Photos &amp; Documents">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter open_attachments="True"/>
            </form>
        </field>
    </record>

    <!-- Employee Tasks & Daily Activities (المهام والأنشطة اليومية) Views -->
    <record id="view_mobile_task_list" model="ir.ui.view">
        <field name="name">hader.mobile.task.list</field>
        <field name="model">hader.mobile.task</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'done'" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <field name="assigned_by_employee_id" optional="show"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'urgent'" decoration-warning="priority == 'high'" decoration-info="priority == 'normal'"/>
                <field name="due_date"/>
                <field name="attachment_count" string="المرفقات / Attachments"/>
                <field name="state" widget="badge" decoration-warning="state == 'todo'" decoration-info="state == 'in_progress'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
                <field name="completed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_task_search" model="ir.ui.view">
        <field name="name">hader.mobile.task.search</field>
        <field name="model">hader.mobile.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <filter name="open_tasks" string="قيد العمل / Open Tasks" domain="[('state','in',['todo','in_progress'])]"/>
                <filter name="done_tasks" string="مكتملة / Completed" domain="[('state','=','done')]"/>
                <filter name="urgent_tasks" string="عاجلة / Urgent" domain="[('priority','in',['high','urgent'])]"/>
                
                    <filter name="group_employee" string="الموظف / Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_state" string="الحالة / Status" context="{'group_by':'state'}"/>
                    <filter name="group_priority" string="الأولوية / Priority" context="{'group_by':'priority'}"/>
                    <filter name="group_due" string="تاريخ الاستحقاق / Due Date" context="{'group_by':'due_date'}"/>
                
            </search>
        </field>
    </record>

    <record id="view_mobile_task_form" model="ir.ui.view">
        <field name="name">hader.mobile.task.form</field>
        <field name="model">hader.mobile.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="بدء التنفيذ / Start" class="btn-primary" invisible="state != 'todo'"/>
                    <button name="action_done" type="object" string="إتمام المهمة / Mark Done" class="btn-success" invisible="state not in ['todo','in_progress']"/>
                    <button name="action_reset_todo" type="object" string="إعادة فتح / Reopen" invisible="state not in ['done','cancelled']"/>
                    <button name="action_cancel" type="object" string="إلغاء / Cancel" class="btn-danger" invisible="state in ['done','cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,done"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="مكتملة / Completed" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="عنوان المهمة أو النشاط اليومي..."/></h2>
                    </div>
                    <group>
                        <group string="بيانات التكليف / Assignment">
                            <field name="employee_id"/>
                            <field name="assigned_by_employee_id"/>
                            <field name="priority"/>
                            <field name="due_date"/>
                        </group>
                        <group string="متابعة الإنجاز / Completion">
                            <field name="completed_at" readonly="1"/>
                            <field name="assigned_by_user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="تفاصيل المهمة المطلوبة / Task Description">
                        <field name="description" nolabel="1" placeholder="اكتب خطوات أو تفاصيل المهمة المطلوبة من الموظف..."/>
                    </group>
                    <group string="ملاحظات الإنجاز من الموظف / Employee Completion Notes">
                        <field name="completion_note" nolabel="1"/>
                    </group>
                    <group string="مرفقات وصور الإنجاز / Task Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter open_attachments="True"/>
            </form>
        </field>
    </record>

    <!-- Employee Loans / Salary Advances (السلف المالية) Views -->
    <record id="view_mobile_loan_list" model="ir.ui.view">
        <field name="name">hader.mobile.loan.list</field>
        <field name="model">hader.mobile.loan</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id" optional="show"/>
                <field name="loan_type"/>
                <field name="request_date"/>
                <field name="deduction_start_date" optional="show"/>
                <field name="amount" sum="Total Loans"/>
                <field name="installments_count"/>
                <field name="installment_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_loan_search" model="ir.ui.view">
        <field name="name">hader.mobile.loan.search</field>
        <field name="model">hader.mobile.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="reason"/>
                <filter name="submitted" string="بانتظار موافقة المدير / Waiting Manager" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="معتمدة / Approved" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="مرفوضة / Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]" context="{'active_test': False}"/>
                
                    <filter name="group_state" string="الحالة / Status" context="{'group_by':'state'}"/>
                    <filter name="group_employee" string="الموظف / Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_type" string="نوع السلفة / Loan Type" context="{'group_by':'loan_type'}"/>
                
            </search>
        </field>
    </record>

    <record id="view_mobile_loan_form" model="ir.ui.view">
        <field name="name">hader.mobile.loan.form</field>
        <field name="model">hader.mobile.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="اعتماد السلفة / Approve" class="btn-success" invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="رفض السلفة / Reject" class="btn-danger" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,approved,rejected"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <widget name="web_ribbon" title="معتمدة / Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="مرفوضة / Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="بيانات السلفة / Loan Details">
                            <field name="employee_id" readonly="state in ['approved','rejected']"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="loan_type" readonly="state in ['approved','rejected']"/>
                            <field name="request_date" readonly="state in ['approved','rejected']"/>
                            <field name="deduction_start_date" readonly="state in ['approved','rejected']"/>
                        </group>
                        <group string="المبلغ والأقساط والاعتماد / Amount &amp; Approval">
                            <field name="amount" readonly="state in ['approved','rejected']"/>
                            <field name="installments_count" readonly="state in ['approved','rejected']"/>
                            <field name="installment_amount" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                            <field name="review_note" placeholder="اكتب ملاحظة الاعتماد أو سبب الرفض هنا..."/>
                        </group>
                    </group>
                    <group string="سبب طلب السلفة / Employee Reason">
                        <field name="reason" nolabel="1" readonly="state in ['approved','rejected']"/>
                    </group>
                    <group string="المرفقات / Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter open_attachments="True"/>
            </form>
        </field>
    </record>

    <record id="action_mobile_services" model="ir.actions.act_window"><field name="name">Employee Services</field><field name="res_model">hader.mobile.service</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_mobile_service_search"/></record>
