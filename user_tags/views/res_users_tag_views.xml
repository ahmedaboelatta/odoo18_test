<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_tag_list" model="ir.ui.view">
        <field name="name">res.users.tag.list</field>
        <field name="model">res.users.tag</field>
        <field name="arch" type="xml">
            <list string="User Tags">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_res_users_tag_form" model="ir.ui.view">
        <field name="name">res.users.tag.form</field>
        <field name="model">res.users.tag</field>
        <field name="arch" type="xml">
            <form string="User Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_users_tag" model="ir.actions.act_window">
        <field name="name">User Tags</field>
        <field name="res_model">res.users.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_res_users_tag"
        name="User Tags"
        parent="base.menu_users"
        action="action_res_users_tag"
        sequence="30"
        groups="base.group_system"
    />
</odoo>
