<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_cpanel_create_mailbox_wizard" model="ir.ui.view"><field name="name">cpanel.mailbox.create.wizard.form</field><field name="model">cpanel.mailbox.create.wizard</field><field name="arch" type="xml"><form string="Create Mailbox"><group><field name="server_id" options="{'no_create': True, 'no_open': True}"/><field name="domain_id" options="{'no_create': True, 'no_open': True}"/><field name="username" placeholder="name"/><field name="email_preview" readonly="1"/><field name="password" password="True"/><field name="quota_mb"/><div class="text-muted">Set quota to 0 for unlimited storage.</div></group><footer><button name="action_create" type="object" string="Create" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field></record>
 <record id="action_cpanel_create_mailbox" model="ir.actions.act_window"><field name="name">Create Mailbox</field><field name="res_model">cpanel.mailbox.create.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
 <record id="view_cpanel_password_wizard" model="ir.ui.view"><field name="name">cpanel.mailbox.password.wizard.form</field><field name="model">cpanel.mailbox.password.wizard</field><field name="arch" type="xml"><form><group><field name="mailbox_id" readonly="1"/><field name="password" password="True"/></group><footer><button name="action_apply" type="object" string="Change Password" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
 <record id="view_cpanel_quota_wizard" model="ir.ui.view"><field name="name">cpanel.mailbox.quota.wizard.form</field><field name="model">cpanel.mailbox.quota.wizard</field><field name="arch" type="xml"><form><group><field name="mailbox_id" readonly="1"/><field name="quota_mb"/></group><footer><button name="action_apply" type="object" string="Change Quota" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
 <record id="view_cpanel_forwarder_create_wizard" model="ir.ui.view"><field name="name">cpanel.forwarder.create.wizard.form</field><field name="model">cpanel.forwarder.create.wizard</field><field name="arch" type="xml"><form string="Add a New Forwarder"><group string="Address"><field name="server_id" options="{'no_create': True, 'no_open': True}"/><field name="domain_id" options="{'no_create': True, 'no_open': True}"/><field name="username"/><field name="source_preview" readonly="1"/></group><group string="Destination"><field name="destination_type" widget="radio"/><field name="destination" invisible="destination_type != 'fwd'" required="destination_type == 'fwd'"/><field name="failure_message" invisible="destination_type != 'fail'" required="destination_type == 'fail'"/></group><footer><button name="action_create" type="object" string="Add Forwarder" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field></record>
 <record id="action_cpanel_create_forwarder" model="ir.actions.act_window"><field name="name">Add Forwarder</field><field name="res_model">cpanel.forwarder.create.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
</odoo>
