<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cpanel" model="ir.module.category"><field name="name">cPanel</field><field name="sequence">25</field></record>
    <record id="group_cpanel_user" model="res.groups"><field name="name">User</field><field name="category_id" ref="module_category_cpanel"/></record>
    <record id="group_cpanel_admin" model="res.groups"><field name="name">Administrator</field><field name="category_id" ref="module_category_cpanel"/><field name="implied_ids" eval="[(4, ref('group_cpanel_user'))]"/></record>
    <record id="rule_cpanel_server_company" model="ir.rule"><field name="name">cPanel servers by company</field><field name="model_id" ref="model_cpanel_server"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cpanel_user'))]"/></record>
    <record id="rule_cpanel_mailbox_company" model="ir.rule"><field name="name">cPanel mailboxes by company</field><field name="model_id" ref="model_cpanel_mailbox"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cpanel_user'))]"/></record>
    <record id="rule_cpanel_domain_company" model="ir.rule"><field name="name">cPanel domains by company</field><field name="model_id" ref="model_cpanel_domain"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cpanel_user'))]"/></record>
    <record id="rule_cpanel_log_company" model="ir.rule"><field name="name">cPanel logs by company</field><field name="model_id" ref="model_cpanel_operation_log"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_cpanel_user'))]"/></record>
</odoo>
