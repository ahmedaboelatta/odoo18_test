<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cpanel_server_dashboard" model="ir.ui.view">
    <field name="name">cpanel.server.dashboard</field>
    <field name="model">cpanel.server</field>
    <field name="arch" type="xml">
      <kanban create="false" delete="false" class="o_kanban_dashboard o_cpanel_dashboard">
        <field name="name"/><field name="host"/><field name="last_status"/><field name="last_sync"/>
        <field name="disk_used_gb"/><field name="disk_limit_gb"/><field name="disk_usage_percent"/><field name="warning_percent"/>
        <field name="database_usage"/><field name="file_usage"/><field name="bandwidth_usage"/>
        <field name="addon_domain_usage"/><field name="subdomain_usage"/><field name="alias_domain_usage"/><field name="email_account_usage"/>
        <field name="forwarder_usage"/><field name="mailing_list_usage"/><field name="autoresponder_usage"/>
        <field name="email_filter_usage"/><field name="ftp_account_usage"/><field name="postgresql_database_usage"/>
        <field name="mailbox_count"/><field name="domain_count"/><field name="restricted_mailbox_count"/>
        <field name="unlimited_mailbox_count"/><field name="over_quota_mailbox_count"/>
        <field name="total_mailbox_used_gb"/><field name="largest_mailbox_id"/>
        <templates>
          <t t-name="card">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div><h3 class="mb-0"><field name="name"/></h3><span class="text-muted"><field name="host"/></span></div>
              <span t-attf-class="badge #{record.last_status.raw_value === 'ok' ? 'text-bg-success' : (record.last_status.raw_value === 'error' ? 'text-bg-danger' : 'text-bg-secondary')}"><field name="last_status"/></span>
            </div>
            <div class="mb-3 p-3 border rounded" t-attf-class="#{record.disk_usage_percent.raw_value &gt;= record.warning_percent.raw_value ? 'border-danger bg-danger-subtle' : 'border-light'}">
              <strong>Disk Usage</strong>
              <div class="fs-4"><field name="disk_used_gb"/> GB / <field name="disk_limit_gb"/> GB</div>
              <div><field name="disk_usage_percent"/>%</div>
              <div class="progress mt-2" style="height: 8px;"><div class="progress-bar" t-att-style="'width:' + Math.min(record.disk_usage_percent.raw_value, 100) + '%'"/></div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3 p-3 border rounded bg-light">
              <div><small class="text-muted">Mailbox Storage</small><div class="fs-5 fw-bold"><field name="total_mailbox_used_gb"/> GB</div><small>Largest: <field name="largest_mailbox_id"/></small></div>
              <button name="action_open_storage_analyzer" type="object" class="btn btn-outline-primary">Storage Analyzer</button>
            </div>
            <div class="row g-2 mb-3">
              <div class="col-12 col-md-6 col-xl-3"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Databases</small><div class="fs-5 fw-bold"><field name="database_usage"/></div></div></div>
              <div class="col-12 col-md-6 col-xl-3"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">File Usage</small><div class="fs-5 fw-bold"><field name="file_usage"/></div></div></div>
              <div class="col-12 col-md-6 col-xl-3"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Bandwidth</small><div class="fs-5 fw-bold"><field name="bandwidth_usage"/></div></div></div>
              <div class="col-12 col-md-6 col-xl-3"><button name="action_open_mailboxes" type="object" class="o_cpanel_metric p-3 border rounded bg-transparent w-100 text-start"><small class="text-muted">Email Accounts</small><div class="fs-5 fw-bold"><field name="email_account_usage"/></div></button></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Addon Domains</small><div class="fs-5 fw-bold"><field name="addon_domain_usage"/></div></div></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Subdomains</small><div class="fs-5 fw-bold"><field name="subdomain_usage"/></div></div></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Aliases</small><div class="fs-5 fw-bold"><field name="alias_domain_usage"/></div></div></div>
              <div class="col-12 col-md-4"><button name="action_open_forwarders" type="object" class="o_cpanel_metric p-3 border rounded bg-transparent w-100 text-start"><small class="text-muted">Forwarders</small><div class="fs-5 fw-bold"><field name="forwarder_usage"/></div></button></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Mailing Lists</small><div class="fs-5 fw-bold"><field name="mailing_list_usage"/></div></div></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Autoresponders</small><div class="fs-5 fw-bold"><field name="autoresponder_usage"/></div></div></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">Email Filters</small><div class="fs-5 fw-bold"><field name="email_filter_usage"/></div></div></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">FTP Accounts</small><div class="fs-5 fw-bold"><field name="ftp_account_usage"/></div></div></div>
              <div class="col-12 col-md-4"><div class="o_cpanel_metric p-3 border rounded"><small class="text-muted">PostgreSQL Databases</small><div class="fs-5 fw-bold"><field name="postgresql_database_usage"/></div></div></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <button name="action_open_mailboxes" type="object" class="badge text-bg-primary border-0">Mailboxes: <field name="mailbox_count"/></button>
              <button name="action_open_domains" type="object" class="badge text-bg-secondary border-0">Domains: <field name="domain_count"/></button>
              <button name="action_open_restricted_mailboxes" type="object" class="badge text-bg-warning border-0">Restricted: <field name="restricted_mailbox_count"/></button>
              <button name="action_open_unlimited_mailboxes" type="object" class="badge text-bg-info border-0">Unlimited: <field name="unlimited_mailbox_count"/></button>
              <button name="action_open_over_quota_mailboxes" type="object" class="badge text-bg-danger border-0">Over quota: <field name="over_quota_mailbox_count"/></button>
            </div>
            <footer class="d-flex justify-content-between align-items-center">
              <small class="text-muted">Last sync: <field name="last_sync"/></small>
              <button name="action_sync" type="object" class="btn btn-primary btn-sm" groups="cpanel_manager.group_cpanel_admin">Synchronize Now</button>
            </footer>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="action_cpanel_dashboard" model="ir.actions.act_window">
    <field name="name">cPanel Dashboard</field>
    <field name="res_model">cpanel.server</field>
    <field name="view_mode">kanban,form</field>
    <field name="view_id" ref="view_cpanel_server_dashboard"/>
  </record>
</odoo>
