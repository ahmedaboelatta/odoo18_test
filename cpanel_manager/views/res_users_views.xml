<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_users_form_cpanel_tags" model="ir.ui.view">
    <field name="name">res.users.form.cpanel.tags</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="cPanel Access" groups="cpanel_manager.group_cpanel_admin">
          <group><field name="cpanel_mailbox_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/><div class="text-muted">Leave empty for unrestricted access. Selecting tags limits this user to matching mailboxes.</div></group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
