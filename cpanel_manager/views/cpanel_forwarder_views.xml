<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cpanel_forwarder_search" model="ir.ui.view">
    <field name="name">cpanel.forwarder.search</field><field name="model">cpanel.forwarder</field>
    <field name="arch" type="xml"><search><field name="source"/><field name="destination"/><field name="server_id"/><filter name="loops" string="Delivery Loops" domain="[('loop_detected','=',True)]"/><filter name="missing" string="Missing Remotely" domain="[('remote_exists','=',False)]"/><group expand="0" string="Group By"><filter name="server" string="Server" context="{'group_by':'server_id'}"/></group></search></field>
  </record>
  <record id="view_cpanel_forwarder_list" model="ir.ui.view">
    <field name="name">cpanel.forwarder.list</field><field name="model">cpanel.forwarder</field>
    <field name="arch" type="xml"><list create="false" edit="false" delete="false" decoration-danger="not remote_exists or loop_detected"><header><button name="%(action_cpanel_create_forwarder)d" type="action" string="Create" class="btn-primary" display="always" groups="cpanel_manager.group_cpanel_admin"/></header><field name="source" string="Email Address"/><field name="destination" string="Forward To"/><field name="loop_detected"/><field name="loop_path" optional="hide"/><field name="server_id"/><field name="remote_exists"/><field name="last_sync"/><button name="action_edit" type="object" string="Edit" icon="fa-pencil" groups="cpanel_manager.group_cpanel_admin" invisible="not remote_exists"/><button name="action_delete_remote" type="object" string="Delete" icon="fa-trash" class="text-danger" confirm="This permanently deletes the forwarder from cPanel. Continue?" groups="cpanel_manager.group_cpanel_admin" invisible="not remote_exists"/></list></field>
  </record>
  <record id="action_cpanel_forwarder" model="ir.actions.act_window">
    <field name="name">Email Forwarders</field><field name="res_model">cpanel.forwarder</field><field name="view_mode">list</field><field name="search_view_id" ref="view_cpanel_forwarder_search"/>
  </record>
</odoo>
