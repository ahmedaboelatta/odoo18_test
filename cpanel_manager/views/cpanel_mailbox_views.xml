<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cpanel_mailbox_search" model="ir.ui.view"><field name="name">cpanel.mailbox.search</field><field name="model">cpanel.mailbox</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="name"/><field name="domain"/><field name="server_id"/><field name="tag_ids"/><separator/><filter name="restricted" string="Restricted" domain="[('is_restricted','=',True)]"/><filter name="system_account" string="System Account" domain="[('is_system_account','=',True)]"/><filter name="exceeded_storage" string="Exceeded Storage" domain="[('is_over_quota','=',True)]"/><filter name="unlimited" string="Unlimited" domain="[('is_unlimited','=',True)]"/><filter name="missing" string="Missing Remotely" domain="[('remote_exists','=',False)]"/><filter name="without_employee" string="Without Employee" domain="[('employee_id','=',False)]"/><group expand="0" string="Group By"><filter name="employee" string="Employee" context="{'group_by':'employee_id'}"/><filter name="server_id" string="Server" context="{'group_by':'server_id'}"/><filter name="domain_group" string="Domain" context="{'group_by':'domain'}"/></group></search></field></record>
  <record id="view_cpanel_mailbox_list" model="ir.ui.view"><field name="name">cpanel.mailbox.list</field><field name="model">cpanel.mailbox</field><field name="arch" type="xml"><list create="false" edit="1" delete="false" editable="bottom" multi_edit="1" decoration-danger="not remote_exists" decoration-warning="is_over_quota"><header><button name="%(action_cpanel_create_mailbox)d" type="action" string="Create" class="btn-primary" display="always" groups="cpanel_manager.group_cpanel_admin"/><button name="%(action_cpanel_mailbox_bulk)d" type="action" string="Add Tags" context="{'default_operation': 'add_tags'}" class="btn-primary" groups="cpanel_manager.group_cpanel_admin"/><button name="%(action_cpanel_mailbox_bulk)d" type="action" string="Remove Tags" context="{'default_operation': 'remove_tags'}" class="btn-secondary" groups="cpanel_manager.group_cpanel_admin"/><button name="%(action_cpanel_mailbox_bulk)d" type="action" string="Bulk Operation" class="btn-secondary" groups="cpanel_manager.group_cpanel_admin"/></header><field name="employee_id"/><field name="name" readonly="1"/><field name="tag_ids" readonly="0" widget="many2many_tags" options="{'color_field': 'color'}"/><field name="server_id" readonly="1"/><field name="used_mb"/><field name="used_gb"/><field name="quota_display"/><field name="quota_gb_display"/><field name="usage_percent" string="Usage (%)"/><field name="is_restricted" string="Restricted"/><field name="is_system_account" optional="hide"/><field name="remote_exists"/><button name="action_open_webmail" type="object" string="Check Email" icon="fa-external-link" groups="cpanel_manager.group_cpanel_admin" invisible="not remote_exists or suspended_login"/><field name="last_sync" optional="hide"/></list></field></record>
  <record id="view_cpanel_mailbox_form" model="ir.ui.view"><field name="name">cpanel.mailbox.form</field><field name="model">cpanel.mailbox</field><field name="arch" type="xml"><form create="false" delete="false"><header><button name="action_open_webmail" type="object" string="Check Email" icon="fa-external-link" class="btn-primary" groups="cpanel_manager.group_cpanel_admin" invisible="not remote_exists or suspended_login"/><button name="action_suspend" type="object" string="Suspend Completely" class="btn-secondary" invisible="suspended_login and suspended_incoming and suspended_outgoing" groups="cpanel_manager.group_cpanel_admin"/><button name="action_unsuspend" type="object" string="Restore" class="btn-primary" invisible="not suspended_login and not suspended_incoming and not suspended_outgoing" groups="cpanel_manager.group_cpanel_admin"/><button name="action_change_password" type="object" string="Change Password" groups="cpanel_manager.group_cpanel_admin"/><button name="action_change_quota" type="object" string="Change Quota" groups="cpanel_manager.group_cpanel_admin"/><button name="action_delete_remote" type="object" string="Delete from cPanel" class="btn-danger" confirm="This permanently deletes the mailbox and its mail data from cPanel. Continue?" groups="cpanel_manager.group_cpanel_admin"/></header><sheet><widget name="web_ribbon" title="Missing from cPanel" bg_color="text-bg-danger" invisible="remote_exists"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="employee_id"/><field name="server_id"/><field name="domain"/><field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/><field name="is_system_account"/><field name="remote_exists"/><field name="last_sync"/></group><group><field name="used_mb"/><field name="used_gb"/><field name="quota_display"/><field name="quota_gb_display"/><field name="usage_percent" string="Usage (%)"/><field name="suspended_login"/><field name="suspended_incoming"/><field name="suspended_outgoing"/></group></group></sheet></form></field></record>
  <record id="action_cpanel_mailbox" model="ir.actions.act_window"><field name="name">Email Accounts</field><field name="res_model">cpanel.mailbox</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_cpanel_mailbox_search"/></record>
</odoo>
