<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cpanel_server_list" model="ir.ui.view"><field name="name">cpanel.server.list</field><field name="model">cpanel.server</field><field name="arch" type="xml"><list decoration-danger="last_status == 'error'"><field name="name"/><field name="host"/><field name="username"/><field name="mailbox_count"/><field name="domain_count"/><field name="disk_usage_percent" widget="percentage"/><field name="last_sync"/><field name="last_status" widget="badge"/></list></field></record>
  <record id="view_cpanel_server_form" model="ir.ui.view"><field name="name">cpanel.server.form</field><field name="model">cpanel.server</field><field name="arch" type="xml"><form><header><button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary" groups="cpanel_manager.group_cpanel_admin"/><button name="action_sync" type="object" string="Synchronize Now" class="btn-primary" groups="cpanel_manager.group_cpanel_admin"/><field name="last_status" widget="statusbar" statusbar_visible="unknown,ok,error"/></header><sheet><div class="oe_button_box" name="button_box"><button type="action" name="%(action_cpanel_mailbox)d" class="oe_stat_button" icon="fa-envelope" context="{'search_default_server_id': id}"><field name="mailbox_count" widget="statinfo" string="Mailboxes"/></button><button type="action" name="%(action_cpanel_domain)d" class="oe_stat_button" icon="fa-globe" context="{'search_default_server_id': id}"><field name="domain_count" widget="statinfo" string="Domains"/></button></div><widget name="web_ribbon" title="Connection Error" bg_color="text-bg-danger" invisible="last_status != 'error'"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Connection"><field name="host" placeholder="server.example.com"/><field name="port"/><field name="username"/><field name="api_token" password="True" groups="cpanel_manager.group_cpanel_admin"/><field name="verify_ssl"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group><group string="Capacity"><field name="disk_used_gb"/><field name="disk_limit_gb"/><field name="disk_usage_percent" widget="percentage"/><field name="warning_percent"/><field name="last_sync"/><field name="last_error" invisible="not last_error"/></group></group><notebook><page string="Mailboxes"><field name="mailbox_ids" readonly="1"><list><field name="name"/><field name="used_mb"/><field name="quota_mb"/><field name="usage_percent" widget="percentage"/><field name="suspended_login"/><field name="remote_exists"/></list></field></page><page string="Domains"><field name="domain_ids" readonly="1"><list><field name="name"/><field name="domain_type"/><field name="document_root"/><field name="https_redirect"/><field name="remote_exists"/></list></field></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_cpanel_server" model="ir.actions.act_window"><field name="name">cPanel Servers</field><field name="res_model">cpanel.server</field><field name="view_mode">list,form</field></record>
</odoo>
